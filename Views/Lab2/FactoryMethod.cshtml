@model List<TMPP_CRM.Domain.Entities.Activity>

@{
    ViewData["Title"] = "Jurnal Activități";
}

<div class="max-w-6xl mx-auto py-8">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-list-dashes text-blue-600 mr-3 text-3xl"></i>
            Jurnal Activități Recente
        </h2>
        <div class="flex space-x-3 mt-4 md:mt-0">
            <button class="inline-flex items-center px-4 py-2 bg-blue-50 text-blue-700 font-medium rounded-lg hover:bg-blue-100 transition-colors">
                <i class="ph ph-plus mr-2 text-lg"></i>
                Adaugă Activitate
            </button>
        </div>
    </div>

    <!-- Filtre (Mock) -->
    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-8 flex flex-wrap gap-4 items-center">
        <div class="text-sm font-medium text-gray-500 mr-2">Filtrează după:</div>
        <select class="text-sm border-gray-200 rounded-lg text-gray-700 py-2 px-3 bg-gray-50 border focus:ring-blue-500 outline-none">
            <option>Toate Tipurile</option>
            <option>Apeluri (Call)</option>
            <option>Email-uri</option>
            <option>Întâlniri (Meeting)</option>
        </select>
        <select class="text-sm border-gray-200 rounded-lg text-gray-700 py-2 px-3 bg-gray-50 border focus:ring-blue-500 outline-none">
            <option>Luna Aceasta</option>
            <option>Săptămâna Aceasta</option>
            <option>Astăzi</option>
        </select>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var activity in Model)
        {
            <div class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 border border-gray-100 flex flex-col">
                <div class="px-5 py-4 border-b border-gray-50 flex justify-between items-center">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold uppercase tracking-wider
                        @(activity.GetActivityType().Contains("Call") ? "bg-green-50 text-green-700" : 
                          activity.GetActivityType().Contains("Email") ? "bg-purple-50 text-purple-700" : "bg-blue-50 text-blue-700")">
                        @if (activity.GetActivityType().Contains("Call")) { 
                            <i class="ph ph-phone mr-1"></i> 
                        }
                        else if (activity.GetActivityType().Contains("Email")) { 
                            <i class="ph ph-envelope-simple mr-1"></i> 
                        }
                        else { 
                            <i class="ph ph-users mr-1"></i> 
                        }
                        @activity.GetActivityType()
                    </span>
                    <span class="text-xs text-gray-400 font-medium">@activity.DueDate.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                
                <div class="p-5 flex-grow">
                    <h5 class="text-lg font-bold text-gray-900 mb-2">@activity.Subject</h5>
                    <p class="text-gray-500 text-sm mb-4 line-clamp-2">@activity.Description</p>
                    
                    <div class="mt-auto pt-4 border-t border-dashed border-gray-100">
                        @if (activity is TMPP_CRM.Domain.Entities.CallActivity call)
                        {
                            <div class="flex items-center text-sm text-gray-700 font-medium">
                                <span class="text-gray-400 mr-2">Număr telefon:</span>
                                @call.PhoneNumber
                            </div>
                        }
                        else if (activity is TMPP_CRM.Domain.Entities.EmailActivity email)
                        {
                            <div class="flex items-center text-sm text-gray-700 font-medium mb-1">
                                <span class="text-gray-400 mr-2">Către:</span>
                                @email.EmailAddress
                            </div>
                            <div class="text-xs text-gray-500 bg-gray-50 p-2 rounded italic mt-2 border border-gray-100">
                                "@email.Body"
                            </div>
                        }
                        else if (activity is TMPP_CRM.Domain.Entities.MeetingActivity meeting)
                        {
                            <div class="flex items-center text-sm text-gray-700 font-medium mb-2">
                                <i class="ph ph-map-pin text-gray-400 mr-2"></i>
                                @meeting.Location
                            </div>
                            <div class="flex items-center text-sm text-gray-700 font-medium">
                                <i class="ph ph-users-three text-gray-400 mr-2"></i>
                                @meeting.Attendees
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
