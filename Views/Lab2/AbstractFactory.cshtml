@model TMPP_CRM.Controllers.ReportViewModel

@{
    ViewData["Title"] = "Generare Rapoarte";
}

<div class="max-w-5xl mx-auto py-8">
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-file-csv text-green-600 mr-3 text-3xl"></i>
            Export și Generare Rapoarte
        </h2>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 mb-8 p-6 lg:p-8 flex flex-col md:flex-row items-center justify-between">
        <div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Alege formatul dorit</h3>
            <p class="text-sm text-gray-500 max-w-md">Selectează formatul de export pentru datele curente din CRM. Aceste rapoarte pot fi importate în sisteme externe ERP sau contabilitate.</p>
        </div>
        
        <div class="flex space-x-4 mt-6 md:mt-0">
            <a href="/Lab2/AbstractFactory?type=csv" class="@(Model.Type == "CSV" ? "bg-green-600 text-white shadow-md shadow-green-500/30 ring-2 ring-green-600 ring-offset-2" : "bg-white text-gray-700 hover:bg-gray-50 border border-gray-200") px-6 py-3 rounded-xl font-medium transition duration-200 flex items-center">
                <i class="ph ph-file-text mr-2 text-xl"></i>
                Export CSV
            </a>
            <a href="/Lab2/AbstractFactory?type=json" class="@(Model.Type == "JSON" ? "bg-yellow-500 text-white shadow-md shadow-yellow-500/30 ring-2 ring-yellow-500 ring-offset-2" : "bg-white text-gray-700 hover:bg-gray-50 border border-gray-200") px-6 py-3 rounded-xl font-medium transition duration-200 flex items-center">
                <i class="ph ph-brackets-curly mr-2 text-xl"></i>
                Export JSON
            </a>
        </div>
    </div>

    <div class="bg-gray-900 rounded-2xl shadow-xl overflow-hidden border border-gray-800">
        <div class="px-6 py-4 bg-gray-800 border-b border-gray-700 flex justify-between items-center">
            <h5 class="font-bold text-gray-200 flex items-center text-sm">
                <i class="ph ph-terminal-window mr-2 text-lg"></i>
                Previzualizare Date 
                <span class="ml-3 px-2.5 py-0.5 rounded-md text-xs font-bold @(Model.Type == "JSON" ? "bg-yellow-500/20 text-yellow-400" : "bg-green-500/20 text-green-400")">
                    @Model.Type
                </span>
            </h5>
            <div class="flex space-x-2">
                <div class="w-3 h-3 rounded-full bg-gray-600"></div>
                <div class="w-3 h-3 rounded-full bg-gray-600"></div>
                <div class="w-3 h-3 rounded-full bg-gray-600"></div>
            </div>
        </div>
        <div class="p-8 font-mono text-sm text-gray-300 overflow-x-auto space-y-6">
            <div>
                <div class="text-xs uppercase tracking-widest text-gray-500 mb-2 font-bold">Metadata Header</div>
                <pre class="bg-gray-950 p-4 rounded-lg text-emerald-400 border border-gray-800 shadow-inner">@Model.Header</pre>
            </div>
            
            <div>
                <div class="text-xs uppercase tracking-widest text-gray-500 mb-2 font-bold">Data Payload</div>
                <pre class="bg-gray-950 p-4 rounded-lg text-gray-100 border border-gray-800 shadow-inner leading-relaxed">@Model.Body</pre>
            </div>
            
            <div>
                <div class="text-xs uppercase tracking-widest text-gray-500 mb-2 font-bold">Checksum / Footer</div>
                <pre class="bg-gray-950 p-4 rounded-lg text-blue-400 border border-gray-800 shadow-inner">@Model.Footer</pre>
            </div>
        </div>
        <div class="bg-gray-800 p-4 flex justify-end border-t border-gray-700">
            <button class="flex items-center px-5 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm font-medium">
                <i class="ph ph-download-simple mr-2"></i>
                Descarcă Fișierul
            </button>
        </div>
    </div>
</div>
