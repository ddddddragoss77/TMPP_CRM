@{
    ViewData["Title"] = "Jurnal & Rapoarte";
}

<div class="max-w-4xl mx-auto py-12">
    <div class="text-center mb-12">
        <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl mb-4">
            Jurnal Activități & Rapoarte
        </h1>
        <p class="text-xl text-gray-500 max-w-2xl mx-auto">
            Loghează interacțiunile cu clienții și generează rapoarte detaliate.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Factory Method Card -> Jurnal Activități -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col hover:border-blue-500 transition-colors group">
            <div class="p-8 flex-grow flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-blue-50 group-hover:bg-blue-100 rounded-full flex items-center justify-center mb-6 transition-colors">
                    <i class="ph ph-phone-call text-3xl text-blue-600"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Jurnal Activități</h3>
                <p class="text-gray-500 leading-relaxed mb-8 flex-grow">
                    Înregistrează rapid interacțiunile cu clienții: <span class="font-semibold text-gray-700">Apeluri, Emailuri și Întâlniri</span>, direct în CRM.
                </p>
                <a href="/Lab2/FactoryMethod" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-blue-600 hover:bg-blue-700 transition w-full shadow-sm">
                    Deschide Jurnal
                </a>
            </div>
        </div>

        <!-- Abstract Factory Card -> Generare Rapoarte -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 flex flex-col hover:border-green-500 transition-colors group">
            <div class="p-8 flex-grow flex flex-col items-center text-center">
                <div class="w-16 h-16 bg-green-50 group-hover:bg-green-100 rounded-full flex items-center justify-center mb-6 transition-colors">
                    <i class="ph ph-file-csv text-3xl text-green-600"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-3">Generare Rapoarte Exportabile</h3>
                <p class="text-gray-500 leading-relaxed mb-8 flex-grow">
                    Exportă datele din CRM în formate standardizate precum <span class="font-semibold text-gray-700">CSV și JSON</span> pentru audit și analiză.
                </p>
                <a href="/Lab2/AbstractFactory" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-green-600 hover:bg-green-700 transition w-full shadow-sm">
                    Generează Raport
                </a>
            </div>
        </div>
    </div>
</div>
