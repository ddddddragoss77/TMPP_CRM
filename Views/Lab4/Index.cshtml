@{
    ViewData["Title"] = "Plăți & Rezervări";
}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Plăți, Produse & Rezervări</h1>
    <p class="text-gray-500 text-lg">Procesează tranzacții, gestionează portofoliul de produse și rezervările clienților.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Adapter -> Terminal Plati -->
    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 group">
        <div class="bg-sky-50 p-6 flex flex-col items-center group-hover:bg-sky-100 transition-colors">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-sky-600 mb-4 shadow-sm">
                <i class="ph ph-credit-card text-3xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900 text-center">Terminal Plăți</h2>
            <p class="text-sky-600 text-sm mt-1 font-medium">Multi-Gateway</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-6 text-center">
                Procesează încasări folosind o interfață unificată, integrând transparent terminale PayPal, Stripe și Google Pay.
            </p>
            <a asp-controller="Lab4" asp-action="Adapter" class="block text-center bg-white border border-gray-200 hover:border-sky-500 hover:text-sky-600 text-gray-700 font-semibold py-2.5 px-4 rounded-xl transition duration-200">
                Deschide Terminalul
            </a>
        </div>
    </div>

    <!-- Composite -> Catalog Produse -->
    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 group">
        <div class="bg-orange-50 p-6 flex flex-col items-center group-hover:bg-orange-100 transition-colors">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-orange-600 mb-4 shadow-sm">
                <i class="ph ph-list-dashes text-3xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900 text-center">Catalog Produse</h2>
            <p class="text-orange-600 text-sm mt-1 font-medium">Structură ierarhică</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-6 text-center">
                Gestionează portofoliul de produse complexe, pachete și sub-pachete, cu calcul automat al prețurilor pe ierarhie.
            </p>
            <a asp-controller="Lab4" asp-action="Composite" class="block text-center bg-white border border-gray-200 hover:border-orange-500 hover:text-orange-600 text-gray-700 font-semibold py-2.5 px-4 rounded-xl transition duration-200">
                Vezi Catalogul
            </a>
        </div>
    </div>

    <!-- Facade -> Sistem Rezervari -->
    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 group">
        <div class="bg-rose-50 p-6 flex flex-col items-center group-hover:bg-rose-100 transition-colors">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-rose-600 mb-4 shadow-sm">
                <i class="ph ph-calendar-check text-3xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900 text-center">Sistem Rezervări</h2>
            <p class="text-rose-600 text-sm mt-1 font-medium">Booking Simplificat</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-6 text-center">
                Efectuează rezervări printr-un singur formular simplificat care orchestrează automat disponibilitatea, plățile și notificările.
            </p>
            <a asp-controller="Lab4" asp-action="Facade" class="block text-center bg-white border border-gray-200 hover:border-rose-500 hover:text-rose-600 text-gray-700 font-semibold py-2.5 px-4 rounded-xl transition duration-200">
                Modul Booking
            </a>
        </div>
    </div>

</div>
