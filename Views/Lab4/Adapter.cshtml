@model TMPP_CRM.Controllers.AdapterInputViewModel
@{
    ViewData["Title"] = "Terminal Procesare Plăți";
}

@if (Model.History.Any())
{
    <!-- DB Transaction Log shown at top -->
    <div class="mb-6 bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden">
        <div class="bg-gray-950 px-5 py-3 border-b border-gray-800 flex justify-between items-center">
            <h4 class="text-sm font-bold text-gray-300 flex items-center"><i class="ph ph-database mr-2 text-sky-400"></i> Tranzacții Salvate în DB (@Model.History.Count)</h4>
        </div>
        <div class="divide-y divide-gray-800 max-h-40 overflow-y-auto">
            @foreach (var tx in Model.History)
            {
                <div class="px-5 py-2.5 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="@(tx.IsSuccess ? "text-emerald-400" : "text-red-400") text-xs font-bold uppercase w-16">@(tx.IsSuccess ? "OK" : "ERR")</span>
                        <span class="text-gray-300 text-sm">@tx.Description</span>
                        <span class="text-gray-500 text-xs">@tx.Provider.ToUpper() — @tx.Amount.ToString("N2") @tx.Currency</span>
                    </div>
                    <span class="text-gray-600 text-xs">@tx.CreatedAt.ToString("dd.MM HH:mm:ss")</span>
                </div>
            }
        </div>
    </div>
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-credit-card text-sky-600 mr-3 text-3xl"></i>
            Terminal Multi-Gateway
        </h1>
        <p class="text-gray-500 mt-1">Procesează tranzacții în siguranță prin mai mulți furnizori de plăți (PayPal, Stripe, GPay).</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
    <!-- Form -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
                <h3 class="font-bold text-gray-800 flex items-center">
                    <i class="ph ph-sliders mr-2 text-sky-500"></i> Configurare Tranzacție
                </h3>
            </div>
            <form method="post" asp-action="Adapter" class="p-6 space-y-5">
                @Html.AntiForgeryToken()

                <!-- Provider -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-3">Procesator Plată</label>
                    <div class="space-y-2">
                        @foreach (var p in new[] {
                            ("paypal",    "PayPal",     "blue",   "ph-paypal-logo"),
                            ("stripe",    "Stripe",     "indigo", "ph-stripe-logo"),
                            ("googlepay", "Google Pay", "gray",   "ph-google-logo")
                        })
                        {
                            <label class="flex items-center p-3 border-2 rounded-xl cursor-pointer transition-all @(Model.Provider == p.Item1 ? $"border-{p.Item3}-400 bg-{p.Item3}-50" : "border-gray-200 hover:border-gray-300")">
                                <input type="radio" name="Provider" value="@p.Item1"
                                       @(Model.Provider == p.Item1 ? "checked" : "") class="sr-only">
                                <i class="ph @p.Item4 mr-3 text-2xl @(Model.Provider == p.Item1 ? $"text-{p.Item3}-600" : "text-gray-400")"></i>
                                <span class="font-bold text-gray-800">@p.Item2</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Amount + Currency -->
                <div class="grid grid-cols-3 gap-3">
                    <div class="col-span-2">
                        <label asp-for="Amount" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Sumă *</label>
                        <input asp-for="Amount" type="number" step="0.01" min="0.01" placeholder="150.00"
                               class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-sky-500 outline-none transition" />
                    </div>
                    <div>
                        <label asp-for="Currency" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Monedă</label>
                        <select asp-for="Currency" class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-sky-500 outline-none">
                            <option value="RON">RON</option>
                            <option value="EUR">EUR</option>
                            <option value="USD">USD</option>
                        </select>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label asp-for="Description" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Descriere Tranzacție</label>
                    <input asp-for="Description" placeholder="ex: Achizitie licenta CRM Pro"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-sky-500 outline-none transition" />
                </div>

                <button type="submit"
                        class="w-full bg-sky-600 hover:bg-sky-700 text-white font-bold py-3 px-6 rounded-xl shadow-md shadow-sky-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-paper-plane-right mr-2 text-lg"></i> Procesează Plata
                </button>
            </form>
        </div>
    </div>

    <!-- Result -->
    <div class="lg:col-span-3">
        @if (Model.HasResult && Model.Result != null)
        {
            <div class="space-y-6">
                <!-- Status Card -->
                <div class="bg-white rounded-2xl shadow-sm border @(Model.Result.IsSuccess ? "border-emerald-200" : "border-red-200") overflow-hidden">
                    <div class="@(Model.Result.IsSuccess ? "bg-emerald-500" : "bg-red-500") text-white p-6 relative overflow-hidden">
                        <i class="ph @(Model.Result.IsSuccess ? "ph-check-circle" : "ph-x-circle") absolute -right-6 -bottom-6 text-9xl opacity-20"></i>
                        <div class="relative z-10">
                            <p class="text-xs uppercase tracking-widest font-bold mb-1 opacity-90">Stare Tranzacție</p>
                            <h2 class="text-3xl font-extrabold">@(Model.Result.IsSuccess ? "APROBATĂ" : "RESPINSĂ")</h2>
                            <div class="mt-2 inline-block bg-white/20 px-3 py-1 rounded-lg text-sm backdrop-blur-sm">
                                Sistem Activ: <strong>@Model.Result.Provider</strong>
                            </div>
                        </div>
                    </div>
                    <div class="p-6 space-y-4">
                        <div class="flex justify-between items-center py-2 border-b border-gray-50">
                            <span class="text-sm text-gray-500 flex items-center"><i class="ph ph-hash mr-2"></i> ID Referință</span>
                            <span class="text-xs font-bold text-gray-900 bg-gray-100 px-2 py-1 rounded">@Model.Result.TransactionId</span>
                        </div>
                        <div class="flex justify-between items-center py-2 border-b border-gray-50">
                            <span class="text-sm text-gray-500 flex items-center"><i class="ph ph-coins mr-2"></i> Valoare Procesată</span>
                            <span class="font-bold text-gray-900 text-lg">@Model.Result.Amount.ToString("F2") @Model.Result.Currency</span>
                        </div>
                        <div class="flex justify-between items-center py-2 border-b border-gray-50">
                            <span class="text-sm text-gray-500 flex items-center"><i class="ph ph-shield-check mr-2"></i> Validare 3D Secure</span>
                            <span class="font-bold @(Model.IsValid ? "text-emerald-600" : "text-red-500")">@(Model.IsValid ? "Aprobat" : "Eșuat")</span>
                        </div>
                        <div class="flex justify-between items-center py-2">
                            <span class="text-sm text-gray-500 flex items-center"><i class="ph ph-clock mr-2"></i> Timestamp</span>
                            <span class="text-sm font-medium text-gray-900">@Model.Result.ProcessedAt.ToString("dd.MM.yyyy HH:mm:ss")</span>
                        </div>
                    </div>
                </div>

                <!-- Jurnal conversie -->
                <div class="bg-gray-900 rounded-2xl shadow-lg p-6 text-gray-300">
                    <h3 class="font-bold text-white mb-6 flex items-center border-b border-gray-800 pb-3">
                        <i class="ph ph-terminal-window mr-2 text-sky-400"></i> Jurnal Conversie Unified API
                    </h3>
                    <div class="space-y-4 text-sm font-mono">
                        <div class="text-sky-400">▶ IPaymentGateway.ProcessPayment(@Model.Amount @Model.Currency)</div>
                        <div class="text-gray-500 pl-4">↓ Adapter @Model.Provider intervine ↓</div>
                        @if (Model.Provider == "stripe")
                        {
                            <div class="text-indigo-400 pl-4">Translate: amountInCents = @((int)(Model.Amount * 100))</div>
                            <div class="text-white bg-indigo-900/50 px-3 py-1 rounded border border-indigo-800 w-fit pl-4">Execute: StripeService.ChargeCard()</div>
                        }
                        else if (Model.Provider == "googlepay")
                        {
                            <div class="text-gray-300 pl-4">Translate: new GooglePayRequest {{ amount = @Model.Amount }}</div>
                            <div class="text-white bg-gray-800 px-3 py-1 rounded border border-gray-700 w-fit pl-4">Execute: GooglePayService.SendPayment()</div>
                        }
                        else
                        {
                            <div class="text-blue-300 pl-4">Translate: amount = (double)@Model.Amount</div>
                            <div class="text-white bg-blue-900/50 px-3 py-1 rounded border border-blue-800 w-fit pl-4">Execute: PayPalService.MakePayment()</div>
                        }
                        <div class="text-emerald-400">✓ Translatare Reușită → Status: @(Model.Result.IsSuccess ? "200 OK" : "REJECTED")</div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="h-full min-h-[400px] flex items-center justify-center bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                <div class="text-center text-gray-400">
                    <i class="ph ph-credit-card text-6xl mb-4 block opacity-30"></i>
                    <p class="font-medium">Selectează un procesator, introdu suma<br>și apasă <strong>„Procesează Plata"</strong>.</p>
                </div>
            </div>
        }
    </div>
</div>
