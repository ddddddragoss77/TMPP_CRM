@model TMPP_CRM.Controllers.FacadeViewModel
@{
    ViewData["Title"] = "Façade Pattern – Rezervare Hotel";
}

<div class="mb-6">
    <a asp-controller="Lab4" asp-action="Index" class="text-rose-500 hover:underline text-sm">← Laborator 4</a>
    <h1 class="text-3xl font-bold text-gray-800 mt-2">🏨 Façade Pattern</h1>
    <p class="text-gray-500 mt-1">Rezervare hotel – o singură metodă, 4 subsisteme ascunse</p>
</div>

<div class="bg-rose-50 border border-rose-200 rounded-xl p-5 mb-6 text-sm text-rose-800">
    <strong>Cum funcționează?</strong> <code>HotelBookingFacade.BookRoom()</code> orchestrează intern:
    <strong>1) Căutare cameră</strong> → <strong>2) Verificare disponibilitate</strong> →
    <strong>3) Procesare plată</strong> → <strong>4) Trimitere confirmare</strong>.
    Tu apelezi o singură metodă — complexitatea este ascunsă!
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- Formular rezervare -->
    <div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
        <h3 class="font-bold text-gray-700 mb-5 text-lg">📝 Formular Rezervare</h3>
        <form method="post" asp-controller="Lab4" asp-action="Facade" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nume Oaspete</label>
                <input type="text" name="GuestName" value="@Model.GuestName" placeholder="Ex: Ion Popescu"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rose-400" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Check-in</label>
                    <input type="date" name="CheckIn" value="@Model.CheckIn.ToString("yyyy-MM-dd")"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rose-400" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Check-out</label>
                    <input type="date" name="CheckOut" value="@Model.CheckOut.ToString("yyyy-MM-dd")"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rose-400" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Tip Cameră</label>
                <select name="RoomType" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-rose-400">
                    @foreach (var t in new[] { "Standard", "Deluxe", "Suite" })
                    {
                        var price = t == "Standard" ? "250" : t == "Deluxe" ? "400" : "800";
                        var label = $"{t} – {price} RON/noapte";
                        var isSelected = Model.RoomType == t;
                        if (isSelected)
                        {
                            <option value="@t" selected>@label</option>
                        }
                        else
                        {
                            <option value="@t">@label</option>
                        }
                    }
                </select>
            </div>
            <button type="submit"
                    class="w-full bg-rose-600 hover:bg-rose-700 text-white font-semibold py-2.5 px-4 rounded-lg transition duration-200">
                🏨 Rezervă Camera
            </button>
        </form>
    </div>

    <!-- Rezultat rezervare -->
    <div>
        @if (Model.Result != null)
        {
            if (Model.Result.IsSuccess)
            {
                <div class="bg-green-600 text-white rounded-2xl p-5 mb-4">
                    <p class="text-green-100 text-xs uppercase tracking-widest">Rezervare Confirmată</p>
                    <h3 class="text-xl font-bold mt-1">✅ Succes!</h3>
                    <p class="text-green-100 text-sm mt-1">@Model.Result.Message</p>
                </div>
                <div class="bg-white rounded-2xl shadow border border-gray-100 p-5 space-y-3">
                    <div class="flex justify-between py-2 border-b"><span class="text-sm text-gray-500">Oaspete</span><span class="font-semibold">@Model.Result.GuestName</span></div>
                    <div class="flex justify-between py-2 border-b"><span class="text-sm text-gray-500">Camera</span><span class="font-semibold">@Model.Result.RoomNumber (@Model.Result.RoomType)</span></div>
                    <div class="flex justify-between py-2 border-b"><span class="text-sm text-gray-500">Check-in</span><span class="font-semibold">@Model.Result.CheckIn.ToString("dd.MM.yyyy")</span></div>
                    <div class="flex justify-between py-2 border-b"><span class="text-sm text-gray-500">Check-out</span><span class="font-semibold">@Model.Result.CheckOut.ToString("dd.MM.yyyy")</span></div>
                    <div class="flex justify-between py-2 border-b"><span class="text-sm text-gray-500">Nopți</span><span class="font-semibold">@Model.Result.Nights</span></div>
                    <div class="flex justify-between py-2 border-b"><span class="text-sm text-gray-500">Total</span><span class="font-bold text-green-700 text-lg">@Model.Result.TotalAmount.ToString("F2") RON</span></div>
                    <div class="flex justify-between py-2"><span class="text-sm text-gray-500">Chitanță</span><code class="text-xs bg-gray-100 px-2 py-1 rounded">@Model.Result.ReceiptNumber</code></div>
                </div>
            }
            else
            {
                <div class="bg-red-50 border-2 border-red-400 rounded-2xl p-5">
                    <h3 class="text-lg font-bold text-red-700">❌ Rezervare eșuată</h3>
                    <p class="text-red-600 text-sm mt-2">@Model.Result.Message</p>
                </div>
            }
        }
        else
        {
            <!-- Diagrama subsisteme -->
            <div class="bg-white rounded-2xl shadow border border-gray-100 p-5">
                <h3 class="font-bold text-gray-700 mb-4">Ce ascunde Façada?</h3>
                <div class="space-y-2">
                    @foreach (var (icon, name, desc) in new[] {
                        ("🔍", "RoomSearchService", "Caută camera după tip și locuri"),
                        ("📅", "AvailabilityService", "Verifică și blochează intervalul"),
                        ("💳", "PaymentService", "Procesează plata și emite chitanță"),
                        ("📧", "NotificationService", "Trimite email de confirmare")
                    })
                    {
                        <div class="flex items-center gap-3 bg-rose-50 border border-rose-100 rounded-lg p-3 text-sm">
                            <span class="text-xl">@icon</span>
                            <div>
                                <code class="text-rose-700 font-semibold">@name</code>
                                <p class="text-gray-500 text-xs">@desc</p>
                            </div>
                        </div>
                    }
                    <div class="text-center text-xs text-gray-400 py-2">↑ orchestrate de ↑</div>
                    <div class="bg-rose-600 text-white rounded-lg p-3 text-center font-bold">
                        HotelBookingFacade.BookRoom()
                    </div>
                </div>
            </div>
        }
    </div>
</div>
