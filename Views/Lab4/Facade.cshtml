@model TMPP_CRM.Controllers.FacadeViewModel
@{
    ViewData["Title"] = "Modul Booking Integrat";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-calendar-check text-rose-600 mr-3 text-3xl"></i>
            Sistem Rezervări Simplificat
        </h1>
        <p class="text-gray-500 mt-1">Înregistrează o rezervare dintr-un singur ecran. Sistemul orchestrează totul automat în fundal.</p>
    </div>
</div>

<div class="bg-white border border-gray-100 rounded-xl p-6 mb-8 text-sm text-gray-600 shadow-sm flex items-start gap-4">
    <i class="ph ph-magic-wand text-rose-500 text-2xl"></i>
    <div>
        <strong class="text-gray-800">Orchestrare Automată:</strong>
        În spatele acestui formular simplu operează 4 microservicii distincte: <span class="font-bold text-xs text-blue-700 uppercase tracking-wider">RoomSearch</span>, <span class="font-bold text-xs text-blue-700 uppercase tracking-wider">Availability</span>, <span class="font-bold text-xs text-blue-700 uppercase tracking-wider">Payment</span> și <span class="font-bold text-xs text-blue-700 uppercase tracking-wider">Notification</span>. Funcția "Rezervă" acționează ca un punct unic de intrare care le coordonează pe toate, ascunzând complexitatea integrării.
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

    <!-- Formular rezervare -->
    <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6">
            <h3 class="font-bold text-gray-900 mb-6 text-lg border-b border-gray-100 pb-3 flex items-center">
                <i class="ph ph-user-focus mr-2 text-rose-500"></i> Date Rezervare
            </h3>
            <form method="post" asp-controller="Lab4" asp-action="Facade" class="space-y-5">
                @Html.AntiForgeryToken()
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Nume Client</label>
                    <div class="relative">
                        <i class="ph ph-user absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" name="GuestName" value="@Model.GuestName" placeholder="Nume complet client" required
                               class="w-full border border-gray-300 rounded-xl pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors" />
                    </div>
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Dată Check-in</label>
                        <input type="date" name="CheckIn" value="@Model.CheckIn.ToString("yyyy-MM-dd")" required
                               class="w-full border border-gray-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">Dată Check-out</label>
                        <input type="date" name="CheckOut" value="@Model.CheckOut.ToString("yyyy-MM-dd")" required
                               class="w-full border border-gray-300 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors" />
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Categorie Cameră</label>
                    <div class="relative">
                        <i class="ph ph-bed absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <select name="RoomType" class="w-full border border-gray-300 rounded-xl pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:border-rose-500 focus:ring-1 focus:ring-rose-500 transition-colors appearance-none bg-white">
                            @foreach (var t in new[] { "Standard", "Deluxe", "Suite" })
                            {
                                var price = t == "Standard" ? "250" : t == "Deluxe" ? "400" : "800";
                                var label = $"{t} – {price} RON/noapte";
                                var isSelected = Model.RoomType == t;
                                if (isSelected)
                                {
                                    <option value="@t" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@t">@label</option>
                                }
                            }
                        </select>
                        <i class="ph ph-caret-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"></i>
                    </div>
                </div>
                
                <div class="pt-2">
                    <button type="submit"
                            class="w-full bg-rose-600 hover:bg-rose-700 text-white font-bold py-3 px-4 rounded-xl shadow-md shadow-rose-600/20 transition-all duration-200 flex justify-center items-center">
                        <i class="ph ph-paper-plane-right mr-2 text-lg"></i> Procesează Rezervarea Integral
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Rezultat rezervare -->
    <div class="lg:col-span-7">
        @if (Model.Result != null)
        {
            if (Model.Result.IsSuccess)
            {
                <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 text-white rounded-2xl p-6 mb-6 shadow-md relative overflow-hidden">
                    <i class="ph ph-check-circle absolute -right-4 -top-4 text-8xl text-white/10"></i>
                    <p class="text-emerald-100 text-xs font-bold uppercase tracking-widest mb-1">Tranzacție Finalizată</p>
                    <h3 class="text-2xl font-extrabold mb-1">Rezervare Confirmată</h3>
                    <p class="text-emerald-50 text-sm">@Model.Result.Message Toate subsistemele au rulat cu succes.</p>
                </div>
                
                <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="bg-gray-50 border-b border-gray-100 px-6 py-4 flex justify-between items-center">
                        <span class="font-bold text-gray-800">Fișă Rezervare</span>
                        <span class="text-xs font-bold bg-white border border-gray-200 px-2 py-1 rounded text-gray-600">ID: @Model.Result.ReceiptNumber</span>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-2 gap-y-4 gap-x-8">
                            <div>
                                <span class="text-xs text-gray-500 uppercase tracking-wider block mb-1">Client Titular</span>
                                <span class="font-bold text-gray-900 text-base">@Model.Result.GuestName</span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-500 uppercase tracking-wider block mb-1">Cameră Alocată</span>
                                <span class="font-bold text-gray-900 text-base flex items-center">
                                    <i class="ph ph-key mr-2 text-rose-500"></i>
                                    @Model.Result.RoomNumber <span class="text-sm font-medium text-gray-500 ml-1">(@Model.Result.RoomType)</span>
                                </span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-500 uppercase tracking-wider block mb-1">Interval Ședere</span>
                                <span class="font-medium text-gray-800">
                                    @Model.Result.CheckIn.ToString("dd MMM yyyy") <i class="ph ph-arrow-right mx-1 text-gray-400"></i> @Model.Result.CheckOut.ToString("dd MMM yyyy")
                                </span>
                            </div>
                            <div>
                                <span class="text-xs text-gray-500 uppercase tracking-wider block mb-1">Durată</span>
                                <span class="font-medium text-gray-800">@Model.Result.Nights nopți</span>
                            </div>
                        </div>
                        
                        <div class="mt-6 pt-6 border-t border-gray-100 flex justify-between items-end">
                            <div>
                                <span class="text-xs text-gray-500 uppercase tracking-wider block mb-1">Status Plată</span>
                                <span class="inline-flex items-center bg-emerald-50 text-emerald-700 text-xs font-bold px-2.5 py-0.5 rounded-md border border-emerald-200">
                                    Achitat Integral
                                </span>
                            </div>
                            <div class="text-right">
                                <span class="text-xs text-gray-500 uppercase tracking-wider block mb-1">Total Încasat</span>
                                <span class="font-black text-rose-600 text-2xl">@Model.Result.TotalAmount.ToString("F2") <span class="text-base text-rose-400">RON</span></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white border border-red-200 rounded-2xl overflow-hidden shadow-sm">
                    <div class="bg-red-50 p-6 border-b border-red-100 flex items-start">
                        <i class="ph ph-warning-circle text-red-500 text-3xl mr-4"></i>
                        <div>
                            <h3 class="text-lg font-bold text-red-800 mb-1">Eroare la procesarea rezervării</h3>
                            <p class="text-red-600 text-sm">Procesul orchestrator a fost întrerupt. O eroare a apărut într-unul din subsisteme.</p>
                        </div>
                    </div>
                    <div class="p-6 bg-red-50/30">
                        <span class="text-sm text-red-700 font-bold">Log: @Model.Result.Message</span>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Diagrama subsisteme -->
            <div class="bg-gray-900 rounded-2xl shadow-lg border border-gray-800 p-8 h-full flex flex-col justify-center">
                <div class="text-center mb-8">
                    <h3 class="font-bold text-white text-xl mb-2">Arhitectura BookingEngine</h3>
                    <p class="text-gray-400 text-sm">Interfața unică declanșează 4 servicii izolate succesiv.</p>
                </div>
                
                <div class="relative">
                    <div class="absolute top-0 bottom-0 left-1/2 w-0.5 bg-gray-700 -translate-x-1/2"></div>
                    
                    <div class="space-y-6 relative z-10">
                        @foreach (var (icon, name, desc, color) in new[] {
                            ("ph-magnifying-glass", "SearchAPI", "Caută camere libere în baza de date", "sky"),
                            ("ph-calendar-check", "AvailabilityManager", "Blochează calendarul pe interval", "emerald"),
                            ("ph-credit-card", "PaymentProcessor", "Încasează și generează chitanța fiscală", "amber"),
                            ("ph-envelope-simple", "NotificationGateway", "Expediază email-ul de confirmare clientului", "purple")
                        })
                        {
                            <div class="bg-gray-800 border border-gray-700 rounded-xl p-4 flex items-center gap-4 w-[90%] mx-auto hover:border-gray-500 transition-colors relative">
                                <div class="w-10 h-10 rounded-full bg-@color-500/20 text-@color-400 flex items-center justify-center shrink-0 border border-@color-500/30">
                                    <i class="ph @icon text-xl"></i>
                                </div>
                                <div>
                                    <span class="text-gray-200 font-bold block mb-0.5">@name</span>
                                    <p class="text-gray-400 text-xs">@desc</p>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="mt-8 relative z-10 flex flex-col items-center">
                        <div class="w-px h-8 bg-rose-500 mb-2"></div>
                        <div class="bg-rose-600 text-white rounded-xl px-6 py-3 font-bold border border-rose-400 shadow-[0_0_15px_rgba(225,29,72,0.5)]">
                            Endpoint: Facade.BookRoom(...)
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
