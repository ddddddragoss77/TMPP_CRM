@{
    ViewData["Title"] = "Vânzări și Configurare";
}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Oferte & Vânzări</h1>
    <p class="text-gray-500 text-lg">Gestionează ofertele comerciale, șabloanele și setările sistemului.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Builder -> Generator Oferte -->
    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 group">
        <div class="bg-blue-50 p-6 flex flex-col items-center group-hover:bg-blue-100 transition-colors">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-blue-600 mb-4 shadow-sm">
                <i class="ph ph-receipt text-3xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900 text-center">Generator Oferte</h2>
            <p class="text-blue-600 text-sm mt-1 font-medium">Standard / Premium / Custom</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-6 text-center">
                Configurează pas cu pas oferte comerciale complexe pentru clienții tăi, adăugând discount-uri și valabilitate.
            </p>
            <a asp-controller="Lab3" asp-action="Builder" class="block text-center bg-white border border-gray-200 hover:border-blue-500 hover:text-blue-600 text-gray-700 font-semibold py-2.5 px-4 rounded-xl transition duration-200">
                Lansează Generatorul
            </a>
        </div>
    </div>

    <!-- Prototype -> Manager Sabloane -->
    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 group">
        <div class="bg-emerald-50 p-6 flex flex-col items-center group-hover:bg-emerald-100 transition-colors">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-emerald-600 mb-4 shadow-sm">
                <i class="ph ph-copy text-3xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900 text-center">Șabloane Rapoarte</h2>
            <p class="text-emerald-600 text-sm mt-1 font-medium">Duplicare inteligentă</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-6 text-center">
                Creează documente noi bazate pe șabloane existente fără a suprascrie configurațiile originale ale rapoartelor.
            </p>
            <a asp-controller="Lab3" asp-action="Prototype" class="block text-center bg-white border border-gray-200 hover:border-emerald-500 hover:text-emerald-600 text-gray-700 font-semibold py-2.5 px-4 rounded-xl transition duration-200">
                Deschide Șabloanele
            </a>
        </div>
    </div>

    <!-- Singleton -> Setari Sistem -->
    <div class="bg-white rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300 overflow-hidden border border-gray-100 group">
        <div class="bg-violet-50 p-6 flex flex-col items-center group-hover:bg-violet-100 transition-colors">
            <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-violet-600 mb-4 shadow-sm">
                <i class="ph ph-hard-drives text-3xl"></i>
            </div>
            <h2 class="text-xl font-bold text-gray-900 text-center">Status Conexiune</h2>
            <p class="text-violet-600 text-sm mt-1 font-medium">Baza de Date & Infrastructură</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-6 text-center">
                Verifică starea și latența conexiunii unice globale la baza de date centrală a ecosistemului Nexus CRM.
            </p>
            <a asp-controller="Lab3" asp-action="Singleton" class="block text-center bg-white border border-gray-200 hover:border-violet-500 hover:text-violet-600 text-gray-700 font-semibold py-2.5 px-4 rounded-xl transition duration-200">
                Verifică Infrastructura
            </a>
        </div>
    </div>
</div>
