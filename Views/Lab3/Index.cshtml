@{
    ViewData["Title"] = "Laborator 3 – Paternuri Creționale";
}

<div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Laborator 3</h1>
    <p class="text-gray-500 text-lg">Paternuri de Proiectare Creționale: Builder, Prototype și Singleton</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Builder -->
    <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-br from-blue-500 to-blue-700 p-6 text-white">
            <div class="text-4xl mb-3">🔨</div>
            <h2 class="text-xl font-bold">Builder Pattern</h2>
            <p class="text-blue-100 text-sm mt-1">Construcție pas cu pas</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-4">
                Crearea de <strong>Oferte Comerciale CRM</strong> (Standard / Premium / Custom)
                folosind un builder cu fluent API și un Director care gestionează pașii.
            </p>
            <ul class="text-xs text-gray-500 space-y-1 mb-5">
                <li>✅ <code>IOfferBuilder</code> – interfață fluent</li>
                <li>✅ <code>OfferBuilder</code> – build + auto-reset</li>
                <li>✅ <code>OfferDirector</code> – Standard / Premium</li>
            </ul>
            <a asp-controller="Lab3" asp-action="Builder"
               class="block text-center bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200">
                Vezi Demo →
            </a>
        </div>
    </div>

    <!-- Prototype -->
    <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 p-6 text-white">
            <div class="text-4xl mb-3">🧬</div>
            <h2 class="text-xl font-bold">Prototype Pattern</h2>
            <p class="text-emerald-100 text-sm mt-1">Clonare shallow & deep</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-4">
                Duplicarea <strong>Șabloanelor de Raport CRM</strong> cu demonstrarea diferenței
                між shallow copy (referințe partajate) și deep copy (obiect complet independent).
            </p>
            <ul class="text-xs text-gray-500 space-y-1 mb-5">
                <li>✅ <code>IPrototype&lt;T&gt;</code> – interfață generică</li>
                <li>✅ <code>ShallowCopy()</code> – MemberwiseClone</li>
                <li>✅ <code>DeepCopy()</code> – copie independentă</li>
            </ul>
            <a asp-controller="Lab3" asp-action="Prototype"
               class="block text-center bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200">
                Vezi Demo →
            </a>
        </div>
    </div>

    <!-- Singleton -->
    <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-br from-violet-500 to-violet-700 p-6 text-white">
            <div class="text-4xl mb-3">🔒</div>
            <h2 class="text-xl font-bold">Singleton Pattern</h2>
            <p class="text-violet-100 text-sm mt-1">O singură instanță globală</p>
        </div>
        <div class="p-6">
            <p class="text-gray-600 text-sm mb-4">
                <strong>DatabaseConnectionManager</strong> – conexiune unică reutilizată de
                toate modulele CRM, thread-safe prin <code>Lazy&lt;T&gt;</code>.
            </p>
            <ul class="text-xs text-gray-500 space-y-1 mb-5">
                <li>✅ Constructor privat</li>
                <li>✅ <code>Lazy&lt;T&gt;</code> thread-safe</li>
                <li>✅ Demonstrație HashCode identic</li>
            </ul>
            <a asp-controller="Lab3" asp-action="Singleton"
               class="block text-center bg-violet-600 hover:bg-violet-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200">
                Vezi Demo →
            </a>
        </div>
    </div>

</div>
