@model TMPP_CRM.Controllers.SingletonViewModel
@{
    ViewData["Title"] = "Singleton Pattern – Manager Conexiune";
}

<div class="mb-6">
    <a asp-controller="Lab3" asp-action="Index" class="text-violet-500 hover:underline text-sm">← Laborator 3</a>
    <h1 class="text-3xl font-bold text-gray-800 mt-2">🔒 Singleton Pattern</h1>
    <p class="text-gray-500 mt-1">O singură instanță globală – DatabaseConnectionManager</p>
</div>

<!-- Explicatie -->
<div class="bg-violet-50 border border-violet-200 rounded-xl p-5 mb-8 text-sm text-violet-800">
    <strong>Cum funcționează?</strong> Oriunde în aplicație se apelează <code>DatabaseConnectionManager.Instance</code>,
    se returnează <strong>exact același obiect</strong> din memorie. Demonstrăm asta prin compararea <code>GetHashCode()</code>
    – dacă sunt identice, înseamnă că e același obiect.
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

    <!-- Status conexiune -->
    <div class="bg-white rounded-2xl shadow border border-gray-100 overflow-hidden">
        <div class="@(Model.IsConnected ? "bg-green-600" : "bg-red-500") text-white p-5">
            <p class="text-xs uppercase tracking-widest opacity-75 mb-1">Status Conexiune</p>
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full @(Model.IsConnected ? "bg-green-300 animate-pulse" : "bg-red-300")"></div>
                <span class="text-2xl font-bold">@(Model.IsConnected ? "CONECTAT" : "DECONECTAT")</span>
            </div>
        </div>
        <div class="p-5 space-y-3">
            <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="text-sm text-gray-500">Connection String</span>
                <code class="text-xs bg-gray-100 px-2 py-1 rounded text-gray-700 max-w-[220px] truncate">@Model.ConnectionString</code>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-100">
                <span class="text-sm text-gray-500">Conectat la ora</span>
                <span class="font-semibold text-gray-700">@Model.ConnectedAt.ToString("HH:mm:ss")</span>
            </div>
            <div class="py-2">
                <p class="text-xs text-gray-400 font-mono">@Model.Status</p>
            </div>
        </div>
    </div>

    <!-- Proba unicitate -->
    <div class="bg-white rounded-2xl shadow border border-gray-100 overflow-hidden">
        <div class="bg-violet-600 text-white p-5">
            <p class="text-xs uppercase tracking-widest opacity-75 mb-1">Dovadă Unicitate</p>
            <h2 class="text-xl font-bold">HashCode Identic ✅</h2>
        </div>
        <div class="p-5 space-y-4">
            <p class="text-sm text-gray-600">
                Ambele apeluri <code>DatabaseConnectionManager.Instance</code> returnează <strong>același obiect</strong>:
            </p>
            <div class="bg-gray-900 text-gray-100 rounded-lg p-4 font-mono text-sm">
                <p class="text-gray-400 text-xs mb-2">// Apel 1</p>
                <p>Instance.GetHashCode() = <span class="text-green-400 font-bold">@Model.HashCode1</span></p>
                <p class="text-gray-400 text-xs mt-3 mb-2">// Apel 2</p>
                <p>Instance.GetHashCode() = <span class="text-green-400 font-bold">@Model.HashCode2</span></p>
                <hr class="border-gray-700 my-3"/>
                <p class="text-yellow-400">@(Model.HashCode1 == Model.HashCode2 ? "✅ IDENTICE – același obiect în memorie!" : "❌ Diferite – BUG în Singleton!")</p>
            </div>
        </div>
    </div>

</div>

<!-- Implementare -->
<div class="bg-white rounded-2xl shadow border border-gray-100 p-6">
    <h3 class="font-bold text-gray-700 mb-4">Cum este implementat – Thread-safe cu <code>Lazy&lt;T&gt;</code></h3>
    <div class="bg-gray-900 text-gray-100 rounded-xl p-5 text-sm font-mono overflow-x-auto">
        <pre><span class="text-purple-400">public sealed class</span> <span class="text-blue-300">DatabaseConnectionManager</span>
{
    <span class="text-gray-500">// Lazy&lt;T&gt; garanteaza creare o singura data, thread-safe</span>
    <span class="text-purple-400">private static readonly</span> Lazy&lt;DatabaseConnectionManager&gt; _instance =
        <span class="text-purple-400">new</span> Lazy&lt;DatabaseConnectionManager&gt;(
            () => <span class="text-purple-400">new</span> DatabaseConnectionManager(),
            LazyThreadSafetyMode.ExecutionAndPublication
        );

    <span class="text-gray-500">// Constructor PRIVAT – previne instantierea externa</span>
    <span class="text-purple-400">private</span> DatabaseConnectionManager() { ... }

    <span class="text-gray-500">// Acces global la instanta unica</span>
    <span class="text-purple-400">public static</span> DatabaseConnectionManager Instance => _instance.Value;
}</pre>
    </div>
    <div class="mt-4 grid grid-cols-3 gap-4 text-center text-sm">
        <div class="bg-violet-50 rounded-lg p-3">
            <div class="text-violet-600 font-bold text-lg">sealed</div>
            <div class="text-gray-500 text-xs">Previne moștenirea</div>
        </div>
        <div class="bg-violet-50 rounded-lg p-3">
            <div class="text-violet-600 font-bold text-lg">private ctor</div>
            <div class="text-gray-500 text-xs">Previne new</div>
        </div>
        <div class="bg-violet-50 rounded-lg p-3">
            <div class="text-violet-600 font-bold text-lg">Lazy&lt;T&gt;</div>
            <div class="text-gray-500 text-xs">Thread-safe</div>
        </div>
    </div>
</div>
