@model TMPP_CRM.Controllers.SingletonViewModel
@{
    ViewData["Title"] = "Status Conexiune & Infrastructură";
}

<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-hard-drives text-violet-600 mr-3 text-3xl"></i>
            Monitorizare Infrastructură
        </h1>
        <p class="text-gray-500 mt-1">Verifică starea nodurilor și a conexiunilor la bazele de date principale.</p>
    </div>
    
    <button class="bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 px-4 py-2 rounded-lg font-medium transition-colors text-sm shadow-sm flex items-center">
        <i class="ph ph-arrows-clockwise mr-2 text-lg"></i> Reîmprospătează
    </button>
</div>

<!-- Indicator Principal -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 mb-8 flex flex-col md:flex-row items-center justify-between">
    <div class="flex items-center mb-6 md:mb-0">
        <div class="w-20 h-20 rounded-full @(Model.IsConnected ? "bg-green-50 text-green-500" : "bg-red-50 text-red-500") flex items-center justify-center mr-6 border-4 @(Model.IsConnected ? "border-green-100" : "border-red-100")">
            <i class="ph ph-database text-4xl"></i>
        </div>
        <div>
            <h2 class="text-sm font-bold text-gray-400 uppercase tracking-widest mb-1">Status Cluster Principal</h2>
            <div class="flex items-center">
                <span class="relative flex h-4 w-4 mr-3">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full @(Model.IsConnected ? "bg-green-400" : "bg-red-400") opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-4 w-4 @(Model.IsConnected ? "bg-green-500" : "bg-red-500")"></span>
                </span>
                <span class="text-3xl font-extrabold text-gray-900">
                    @(Model.IsConnected ? "ONLINE" : "OFFLINE")
                </span>
            </div>
            <p class="text-gray-500 mt-2 text-sm max-w-md">Toate serviciile CRM operează normal. Latența conexiunii este sub limitele de alertă (12ms).</p>
        </div>
    </div>
    
    <div class="bg-gray-50 p-5 rounded-xl border border-gray-100 w-full md:w-auto min-w-[300px]">
        <div class="space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-500">Uptime</span>
                <span class="font-bold text-gray-900">99.99%</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-500">Conectat la</span>
                <span class="font-bold text-gray-900">@Model.ConnectedAt.ToString("HH:mm:ss")</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-500">Nod Activ</span>
                <span class="font-medium text-xs bg-white border border-gray-200 px-2 py-1 rounded text-violet-700">EU-CENTRAL-1</span>
            </div>
        </div>
    </div>
</div>

<!-- Log Conexiuni -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50">
        <h3 class="font-bold text-gray-900 flex items-center">
            <i class="ph ph-activity mr-2 text-violet-600"></i>
            Diagnostic Conexiuni Paralele
        </h3>
        <span class="bg-violet-100 text-violet-800 text-xs font-bold px-2.5 py-1 rounded-md border border-violet-200">
            Conexiune Unică Garantată
        </span>
    </div>
    
    <div class="p-6">
        <p class="text-sm text-gray-600 mb-6">Sistemul este optimizat să refolosească o singură instanță de conexiune pentru toate modulele CRM active, economisind resurse și memorie. HashCode-ul identic demonstrează reutilizarea obiectului în memorie.</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-gray-900 rounded-xl p-5 border border-gray-800 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1 h-full bg-blue-500"></div>
                <div class="text-gray-400 text-xs mb-3 font-medium uppercase tracking-widest flex items-center">
                    <i class="ph ph-terminal-window mr-2"></i> Proces 1 (Modul Vânzări)
                </div>
                <div class="font-medium text-sm">
                    <span class="text-gray-500">Requesting connection...</span><br/>
                    <span class="text-white">ConnManager.GetInstance()</span><br/>
                    <span class="text-gray-500">Memory Ref Hash:</span> <span class="text-green-400 font-bold">@Model.HashCode1</span>
                </div>
            </div>
            
            <div class="bg-gray-900 rounded-xl p-5 border border-gray-800 relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1 h-full bg-purple-500"></div>
                <div class="text-gray-400 text-xs mb-3 font-medium uppercase tracking-widest flex items-center">
                    <i class="ph ph-terminal-window mr-2"></i> Proces 2 (Modul Rapoarte)
                </div>
                <div class="font-medium text-sm">
                    <span class="text-gray-500">Requesting connection...</span><br/>
                    <span class="text-white">ConnManager.GetInstance()</span><br/>
                    <span class="text-gray-500">Memory Ref Hash:</span> <span class="text-green-400 font-bold">@Model.HashCode2</span>
                </div>
            </div>
        </div>
        
        <div class="mt-6 flex items-center justify-center p-4 bg-green-50 border border-green-200 rounded-xl text-green-800 text-sm font-medium">
            <i class="ph ph-check-circle text-xl mr-2 text-green-600"></i>
            Validare: Ambele procese utilizează instanța sigură a conexiunii (HashCode @Model.HashCode1).
        </div>
    </div>
</div>
