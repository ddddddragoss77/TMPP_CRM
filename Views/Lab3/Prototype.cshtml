@model TMPP_CRM.Controllers.PrototypeViewModel
@{
    ViewData["Title"] = "Manager Șabloane Rapoarte";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-copy text-emerald-600 mr-3 text-3xl"></i>
            Șabloane Rapoarte CRM
        </h1>
        <p class="text-gray-500 mt-1">Gestionează și multiplică șabloanele de documente fără a afecta originalul.</p>
    </div>
</div>

<!-- Explicatie -->
<div class="bg-white border border-gray-100 rounded-xl p-6 mb-8 text-sm text-gray-600 shadow-sm">
    <strong>Sistem de Versionare:</strong> La duplicarea unui șablon, sistemul folosește duplicarea în profunzime (Deep Copy) pentru a asigura că documentul nou este 100% independent. Orice modificare adusă clonei nu va afecta niciodată șablonul original.
</div>

<!-- Alerta shallow (re-purposed ca alerta de audit) -->
<div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-6 flex gap-3 items-start">
    <i class="ph ph-info text-blue-500 text-xl"></i>
    <div class="text-sm">
        <strong class="text-blue-900">Jurnal Audit Modificări</strong><br/>
        <span class="text-blue-700">Conținut original: "<em>@Model.OriginalSection0Content</em>"</span><br/>
        <span class="text-blue-600 opacity-80">Orice modificare ulterioară este urmărită și versionată izolat.</span>
    </div>
</div>

<!-- Grid comparatie -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

    <!-- Original -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden relative">
        <div class="absolute top-4 right-4">
            <span class="bg-gray-100 text-gray-600 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest">Șablon Master</span>
        </div>
        <div class="bg-gray-50 border-b border-gray-100 p-6 pt-12">
            <h2 class="font-bold text-xl text-gray-900 truncate">@Model.Original.Title</h2>
            <p class="text-gray-400 text-sm mt-1 font-mono">ID Referință: @Model.Original.Id.ToString()[..8]…</p>
        </div>
        <div class="p-6 space-y-4">
            <div class="grid grid-cols-2 gap-4 bg-white border border-gray-100 rounded-xl p-4">
                <div>
                    <span class="text-xs text-gray-500 block uppercase tracking-wider mb-1">Autor Creator</span>
                    <span class="font-medium text-gray-900">@Model.Original.Author</span>
                </div>
                <div>
                    <span class="text-xs text-gray-500 block uppercase tracking-wider mb-1">Data Creării</span>
                    <span class="font-medium text-gray-900">@Model.Original.CreatedAt.ToString("HH:mm:ss")</span>
                </div>
            </div>
            
            <div>
                <p class="text-xs font-bold text-gray-900 uppercase tracking-widest mb-3 flex items-center">
                    <i class="ph ph-list-dashes mr-2 text-gray-400"></i> Secțiuni Actuale (@Model.Original.Sections.Count)
                </p>
                <div class="space-y-2">
                    @foreach (var s in Model.Original.Sections)
                    {
                        <div class="bg-gray-50 rounded-lg p-3 text-sm border border-gray-100">
                            <p class="font-semibold text-gray-800 mb-1">@s.Title</p>
                            <p class="text-gray-500 @(s.Content.Contains("MODIFICAT") ? "text-red-500 font-bold" : "")">@s.Content</p>
                        </div>
                    }
                </div>
            </div>
            
            <div>
                <p class="text-xs font-bold text-gray-900 uppercase tracking-widest mb-3 mt-6 flex items-center">
                    <i class="ph ph-palette mr-2 text-gray-400"></i> Formatare Aplicată
                </p>
                <div class="bg-gray-50 rounded-lg p-3 space-y-2 border border-gray-100">
                    @foreach (var kv in Model.Original.FormattingSettings)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">@kv.Key</span>
                            <span class="text-gray-900 font-medium">@kv.Value</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Deep Copy (Draft nou) -->
    <div class="bg-white rounded-2xl shadow-md border-2 border-emerald-500 overflow-hidden relative">
        <div class="absolute top-4 right-4">
            <span class="bg-emerald-100 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest flex items-center">
                <i class="ph ph-check-circle mr-1"></i> Draft Nou
            </span>
        </div>
        <div class="bg-emerald-50/50 border-b border-emerald-100 p-6 pt-12">
            <h2 class="font-bold text-xl text-emerald-900 truncate">@Model.DeepCopy.Title</h2>
            <p class="text-emerald-600/70 text-sm mt-1 font-mono">ID Generat: @Model.DeepCopy.Id.ToString()[..8]…</p>
        </div>
        <div class="p-6 space-y-4">
            <div class="grid grid-cols-2 gap-4 bg-white border border-emerald-100 rounded-xl p-4">
                <div>
                    <span class="text-xs text-emerald-600/70 block uppercase tracking-wider mb-1">Autor Modificare</span>
                    <span class="font-medium text-emerald-900">@Model.DeepCopy.Author</span>
                </div>
                <div>
                    <span class="text-xs text-emerald-600/70 block uppercase tracking-wider mb-1">Data Duplicării</span>
                    <span class="font-medium text-emerald-900">@Model.DeepCopy.CreatedAt.ToString("HH:mm:ss")</span>
                </div>
            </div>
            
            <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-3 text-sm text-emerald-700 flex items-center">
                <i class="ph ph-shield-check text-xl mr-3"></i>
                <div>
                    Documentul este complet decuplat de Master. Editările sunt în siguranță.
                </div>
            </div>

            <div>
                <p class="text-xs font-bold text-emerald-900 uppercase tracking-widest mb-3 flex items-center">
                    <i class="ph ph-list-dashes mr-2 text-emerald-500/50"></i> Secțiuni Editabile
                </p>
                <div class="space-y-2">
                    @foreach (var s in Model.DeepCopy.Sections)
                    {
                        <div class="bg-white rounded-lg p-3 text-sm border border-emerald-100 shadow-sm">
                            <p class="font-semibold text-gray-800 mb-1">@s.Title</p>
                            <p class="text-gray-500">@s.Content</p>
                        </div>
                    }
                </div>
            </div>
            
            <div>
                <p class="text-xs font-bold text-emerald-900 uppercase tracking-widest mb-3 mt-6 flex items-center">
                    <i class="ph ph-palette mr-2 text-emerald-500/50"></i> Formatare Moștenită
                </p>
                <div class="bg-white rounded-lg p-3 space-y-2 border border-emerald-100 shadow-sm">
                    @foreach (var kv in Model.DeepCopy.FormattingSettings)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">@kv.Key</span>
                            <span class="text-gray-900 font-medium">@kv.Value</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="bg-gray-50 p-4 border-t border-gray-100 flex justify-end gap-3">
            <button class="bg-white border border-gray-200 text-gray-700 hover:bg-gray-50 px-4 py-2 rounded-lg font-medium transition-colors text-sm">
                Anulează
            </button>
            <button class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg font-medium transition-colors shadow-sm text-sm">
                Salvează Modificările
            </button>
        </div>
    </div>
</div>
