@model TMPP_CRM.Controllers.PrototypeViewModel
@{
    ViewData["Title"] = "Prototype Pattern – Clonare Raport";
}

<div class="mb-6">
    <a asp-controller="Lab3" asp-action="Index" class="text-emerald-500 hover:underline text-sm">← Laborator 3</a>
    <h1 class="text-3xl font-bold text-gray-800 mt-2">🧬 Prototype Pattern</h1>
    <p class="text-gray-500 mt-1">Clonarea șabloanelor de raport CRM – Shallow Copy vs Deep Copy</p>
</div>

<!-- Explicatie -->
<div class="bg-emerald-50 border border-emerald-200 rounded-xl p-5 mb-8 text-sm text-emerald-800">
    <strong>Demonstrație:</strong> Am modificat <code>Sections[0].Content</code> pe <strong>Shallow Copy</strong>.
    Observă că originalul este și el afectat (referință partajată), dar <strong>Deep Copy</strong> rămâne neafectat.
</div>

<!-- Alerta shallow -->
<div class="bg-red-50 border border-red-300 rounded-xl p-4 mb-6 flex gap-3 items-start">
    <span class="text-red-500 text-xl">⚠️</span>
    <div class="text-sm">
        <strong class="text-red-700">Efect Shallow Copy detectat!</strong><br/>
        <span class="text-red-600">Original <code>Sections[0].Content</code> = "<em>@Model.OriginalSection0Content</em>"</span><br/>
        <span class="text-gray-500">A fost modificat indirect prin Shallow Copy (referință partajată la lista de secțiuni).</span>
    </div>
</div>

<!-- Grid comparatie -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Original -->
    <div class="bg-white rounded-2xl shadow border border-gray-200 overflow-hidden">
        <div class="bg-gray-700 text-white p-4">
            <p class="text-xs text-gray-300 uppercase tracking-widest">Original</p>
            <h2 class="font-bold text-lg truncate">@Model.Original.Title</h2>
            <p class="text-gray-300 text-xs mt-1">ID: @Model.Original.Id.ToString()[..8]…</p>
        </div>
        <div class="p-4 space-y-3">
            <div class="text-xs text-gray-500">Autor: <span class="font-medium text-gray-700">@Model.Original.Author</span></div>
            <div class="text-xs text-gray-500">Creat: <span class="font-medium text-gray-700">@Model.Original.CreatedAt.ToString("HH:mm:ss")</span></div>
            <hr/>
            <p class="text-xs font-semibold text-gray-400 uppercase">Secțiuni (@Model.Original.Sections.Count)</p>
            @foreach (var s in Model.Original.Sections)
            {
                <div class="bg-gray-50 rounded-lg p-2 text-xs">
                    <p class="font-semibold text-gray-700">@s.Title</p>
                    <p class="text-gray-500 @(s.Content.Contains("MODIFICAT") ? "text-red-500 font-bold" : "")">@s.Content</p>
                </div>
            }
            <hr/>
            <p class="text-xs font-semibold text-gray-400 uppercase">Formatare</p>
            @foreach (var kv in Model.Original.FormattingSettings)
            {
                <div class="flex justify-between text-xs">
                    <span class="text-gray-500">@kv.Key</span>
                    <span class="text-gray-700 font-medium">@kv.Value</span>
                </div>
            }
        </div>
    </div>

    <!-- Shallow Copy -->
    <div class="bg-white rounded-2xl shadow border-2 border-red-300 overflow-hidden">
        <div class="bg-red-500 text-white p-4">
            <p class="text-xs text-red-100 uppercase tracking-widest">Shallow Copy ⚠️</p>
            <h2 class="font-bold text-lg truncate">@Model.ShallowCopy.Title</h2>
            <p class="text-red-100 text-xs mt-1">ID: @Model.ShallowCopy.Id.ToString()[..8]…</p>
        </div>
        <div class="p-4 space-y-3">
            <div class="text-xs text-gray-500">Autor: <span class="font-medium text-gray-700">@Model.ShallowCopy.Author</span></div>
            <div class="text-xs text-gray-500">Creat: <span class="font-medium text-gray-700">@Model.ShallowCopy.CreatedAt.ToString("HH:mm:ss")</span></div>
            <div class="bg-red-50 border border-red-200 rounded p-2 text-xs text-red-700">
                ⚠️ Lista de secțiuni este <strong>aceeași referință</strong> ca originalul!
            </div>
            <hr/>
            <p class="text-xs font-semibold text-gray-400 uppercase">Secțiuni (partajate!)</p>
            @foreach (var s in Model.ShallowCopy.Sections)
            {
                <div class="bg-red-50 rounded-lg p-2 text-xs border border-red-100">
                    <p class="font-semibold text-gray-700">@s.Title</p>
                    <p class="@(s.Content.Contains("MODIFICAT") ? "text-red-600 font-bold" : "text-gray-500")">@s.Content</p>
                </div>
            }
        </div>
    </div>

    <!-- Deep Copy -->
    <div class="bg-white rounded-2xl shadow border-2 border-emerald-300 overflow-hidden">
        <div class="bg-emerald-600 text-white p-4">
            <p class="text-xs text-emerald-100 uppercase tracking-widest">Deep Copy ✅</p>
            <h2 class="font-bold text-lg truncate">@Model.DeepCopy.Title</h2>
            <p class="text-emerald-100 text-xs mt-1">ID: @Model.DeepCopy.Id.ToString()[..8]…</p>
        </div>
        <div class="p-4 space-y-3">
            <div class="text-xs text-gray-500">Autor: <span class="font-medium text-gray-700">@Model.DeepCopy.Author</span></div>
            <div class="text-xs text-gray-500">Creat: <span class="font-medium text-gray-700">@Model.DeepCopy.CreatedAt.ToString("HH:mm:ss")</span></div>
            <div class="bg-emerald-50 border border-emerald-200 rounded p-2 text-xs text-emerald-700">
                ✅ Complet independent – modificările nu afectează originalul!
            </div>
            <hr/>
            <p class="text-xs font-semibold text-gray-400 uppercase">Secțiuni (copiate)</p>
            @foreach (var s in Model.DeepCopy.Sections)
            {
                <div class="bg-emerald-50 rounded-lg p-2 text-xs border border-emerald-100">
                    <p class="font-semibold text-gray-700">@s.Title</p>
                    <p class="text-gray-500">@s.Content</p>
                </div>
            }
            <hr/>
            <p class="text-xs font-semibold text-gray-400 uppercase">Formatare (copiată)</p>
            @foreach (var kv in Model.DeepCopy.FormattingSettings)
            {
                <div class="flex justify-between text-xs">
                    <span class="text-gray-500">@kv.Key</span>
                    <span class="text-gray-700 font-medium">@kv.Value</span>
                </div>
            }
        </div>
    </div>

</div>

<!-- Tabel comparatie -->
<div class="mt-8 bg-white rounded-xl shadow border border-gray-100 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
            <tr>
                <th class="px-6 py-3 text-left">Aspect</th>
                <th class="px-6 py-3 text-center">Shallow Copy</th>
                <th class="px-6 py-3 text-center">Deep Copy</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            <tr><td class="px-6 py-3 text-gray-600">Obiect nou creat</td><td class="px-6 py-3 text-center text-green-600 font-bold">✅ Da</td><td class="px-6 py-3 text-center text-green-600 font-bold">✅ Da</td></tr>
            <tr><td class="px-6 py-3 text-gray-600">ID nou</td><td class="px-6 py-3 text-center text-green-600 font-bold">✅ Da</td><td class="px-6 py-3 text-center text-green-600 font-bold">✅ Da</td></tr>
            <tr><td class="px-6 py-3 text-gray-600">Lista Sections independentă</td><td class="px-6 py-3 text-center text-red-500 font-bold">❌ Nu</td><td class="px-6 py-3 text-center text-green-600 font-bold">✅ Da</td></tr>
            <tr><td class="px-6 py-3 text-gray-600">FormattingSettings independent</td><td class="px-6 py-3 text-center text-red-500 font-bold">❌ Nu</td><td class="px-6 py-3 text-center text-green-600 font-bold">✅ Da</td></tr>
            <tr><td class="px-6 py-3 text-gray-600">Modificările nu afectează originalul</td><td class="px-6 py-3 text-center text-red-500 font-bold">❌ Nu</td><td class="px-6 py-3 text-center text-green-600 font-bold">✅ Da</td></tr>
        </tbody>
    </table>
</div>
