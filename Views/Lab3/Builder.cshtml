@model TMPP_CRM.Controllers.BuilderViewModel
@{
    ViewData["Title"] = "Generator Ofertă";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-receipt text-blue-600 mr-3 text-3xl"></i>
            Generator Oferte Comerciale
        </h1>
        <p class="text-gray-500 mt-1">Configurează și generează oferte comerciale personalizate pentru clienți.</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
    <!-- Form -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
                <h3 class="font-bold text-gray-800 flex items-center">
                    <i class="ph ph-sliders mr-2 text-blue-500"></i> Parametri Ofertă
                </h3>
            </div>
            <form method="post" asp-action="Builder" class="p-6 space-y-5">
                @Html.AntiForgeryToken()

                <!-- Tip Oferta -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-3">Tip Șablon</label>
                    <div class="space-y-2">
                        @foreach (var t in new[] {
                            ("standard", "Pachet Standard", "blue", "ph-briefcase", "5% discount, 30 zile"),
                            ("premium",  "Pachet Premium",  "amber","ph-star",      "20% discount, 90 zile, toate modulele"),
                            ("custom",   "Enterprise Custom","gray","ph-buildings", "Discount & produse personalizate")
                        })
                        {
                            <label class="flex items-center p-3 border-2 rounded-xl cursor-pointer transition-all @(Model.OfferType == t.Item1 ? $"border-{t.Item3}-400 bg-{t.Item3}-50" : "border-gray-200 hover:border-gray-300 bg-white")">
                                <input type="radio" name="OfferType" value="@t.Item1"
                                       @(Model.OfferType == t.Item1 ? "checked" : "")
                                       class="sr-only"
                                       onchange="this.form.submit(); updateCustomFields();">
                                <i class="ph @t.Item4 mr-3 text-xl @(Model.OfferType == t.Item1 ? $"text-{t.Item3}-600" : "text-gray-400")"></i>
                                <div>
                                    <span class="block font-bold text-gray-800 text-sm">@t.Item2</span>
                                    <span class="block text-xs text-gray-500">@t.Item5</span>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Nume Client -->
                <div>
                    <label asp-for="ClientName" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Nume Client *</label>
                    <input asp-for="ClientName" placeholder="ex: TechCorp SRL"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-400 outline-none transition" />
                </div>

                <!-- Custom Fields (only shown for custom) -->
                <div id="customFields" class="space-y-4 @(Model.OfferType == "custom" ? "" : "hidden")">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-2">Produse/Module Custom</label>
                        @for (int i = 0; i < Model.CustomProducts.Count; i++)
                        {
                            <div class="flex items-center gap-2 mb-2">
                                <input type="text" name="CustomProducts[@i]" value="@Model.CustomProducts[i]"
                                       placeholder="Modul @(i+1)"
                                       class="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
                            </div>
                        }
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label asp-for="CustomDiscount" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Discount (%)</label>
                            <input asp-for="CustomDiscount" type="number" min="0" max="100"
                                   class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
                        </div>
                        <div>
                            <label asp-for="CustomValidity" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Valabilitate (zile)</label>
                            <input asp-for="CustomValidity" type="number" min="1"
                                   class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
                        </div>
                    </div>
                </div>

                <button type="submit"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-md shadow-blue-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-gear mr-2 text-lg"></i> Generează Oferta
                </button>
            </form>
        </div>
    </div>

    <!-- Result -->
    <div class="lg:col-span-3">
        @if (Model.HasResult && Model.Result != null)
        {
            var offer = Model.Result;
            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
                <div class="bg-gradient-to-r from-gray-900 to-gray-800 p-8 text-white relative overflow-hidden">
                    <div class="absolute top-0 right-0 -mt-8 -mr-8 w-32 h-32 bg-white opacity-5 rounded-full blur-2xl"></div>
                    <div class="flex justify-between items-start relative z-10">
                        <div>
                            <p class="text-gray-400 text-xs uppercase tracking-widest mb-1 font-semibold">Propunere Comercială</p>
                            <h2 class="text-3xl font-bold mb-2">@offer.Title</h2>
                            <p class="text-gray-300">Generată pentru: <strong class="text-white">@offer.ClientName</strong></p>
                        </div>
                        <span class="bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-bold px-4 py-2 rounded-xl flex items-center">
                            <i class="ph ph-tag mr-2 text-lg"></i>
                            @offer.Discount% DISCOUNT
                        </span>
                    </div>
                </div>

                <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest mb-4 flex items-center">
                            <i class="ph ph-package text-blue-500 mr-2 text-lg"></i>
                            Produse și Servicii
                        </h3>
                        @if (offer.Products.Any())
                        {
                            <ul class="space-y-3">
                                @foreach (var p in offer.Products)
                                {
                                    <li class="flex items-center text-gray-700 font-medium">
                                        <i class="ph ph-check-circle text-emerald-500 mr-3 text-lg"></i> @p
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-gray-400 text-sm italic">Niciun produs specificat.</p>
                        }
                    </div>

                    <div>
                        <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest mb-4">Condiții Comerciale</h3>
                        <div class="space-y-4">
                            <div class="flex justify-between items-center py-2 border-b border-gray-50">
                                <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-hash mr-2"></i> ID Referință</span>
                                <code class="text-xs font-bold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-md">@offer.Id.ToString("N")[..8].ToUpper()</code>
                            </div>
                            <div class="flex justify-between items-center py-2 border-b border-gray-50">
                                <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-percent mr-2"></i> Reducere Aplicată</span>
                                <span class="font-bold text-emerald-600">@offer.Discount%</span>
                            </div>
                            <div class="flex justify-between items-center py-2 border-b border-gray-50">
                                <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-calendar-blank mr-2"></i> Valabilitate</span>
                                <span class="font-bold text-gray-900">@offer.ValidityDays zile</span>
                            </div>
                            <div class="flex justify-between items-center py-2 border-b border-gray-50">
                                <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-clock mr-2"></i> Data emiterii</span>
                                <span class="text-gray-900 text-sm font-medium">@offer.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(offer.Notes))
                {
                    <div class="px-8 pb-8">
                        <div class="bg-yellow-50 border border-yellow-100 rounded-xl p-4 text-sm text-yellow-800 flex">
                            <i class="ph ph-info text-yellow-600 mr-3 text-xl"></i>
                            <div>
                                <strong class="block mb-1 text-yellow-900">Note interne &amp; Termeni:</strong>
                                @offer.Notes
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="h-full min-h-[400px] flex items-center justify-center bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                <div class="text-center text-gray-400">
                    <i class="ph ph-receipt text-6xl mb-4 block opacity-30"></i>
                    <p class="font-medium">Completează formularul și apasă <br><strong>„Generează Oferta"</strong> pentru a vedea rezultatul.</p>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function updateCustomFields() {
        const selected = document.querySelector('input[name="OfferType"]:checked')?.value;
        const block = document.getElementById('customFields');
        if (block) block.classList.toggle('hidden', selected !== 'custom');
    }
    updateCustomFields();
    document.querySelectorAll('input[name="OfferType"]').forEach(r => r.addEventListener('change', updateCustomFields));
</script>
