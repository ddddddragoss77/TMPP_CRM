@model TMPP_CRM.Domain.Builders.Offer
@{
    ViewData["Title"] = "Builder Pattern – Ofertă Comercială";
    var selectedType = ViewBag.SelectedType as string ?? "standard";
}

<div class="mb-6">
    <a asp-controller="Lab3" asp-action="Index" class="text-blue-500 hover:underline text-sm">← Laborator 3</a>
    <h1 class="text-3xl font-bold text-gray-800 mt-2">🔨 Builder Pattern</h1>
    <p class="text-gray-500 mt-1">Construcție pas cu pas a ofertelor comerciale CRM</p>
</div>

<!-- Explicatie pattern -->
<div class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-6 text-sm text-blue-800">
    <strong>Cum funcționează?</strong> Director-ul primește un <code>IOfferBuilder</code> și apelează metodele
    în ordine definită, fără ca clientul să cunoască detaliile construirii. Fluent API permite înlănțuirea metodelor.
</div>

<!-- Selectare tip oferta -->
<div class="flex gap-3 mb-8">
    @foreach (var t in new[] { ("standard", "Standard", "bg-blue-600"), ("premium", "Premium ⭐", "bg-amber-500"), ("custom", "Custom", "bg-gray-600") })
    {
        <a asp-controller="Lab3" asp-action="Builder" asp-route-type="@t.Item1"
           class="px-5 py-2 rounded-lg text-white font-semibold transition duration-200 hover:opacity-90 @(selectedType == t.Item1 ? t.Item3 + " ring-2 ring-offset-2 ring-" + t.Item3.Split('-')[1] + "-400" : "bg-gray-300 text-gray-700")">
            @t.Item2
        </a>
    }
</div>

<!-- Rezultat oferta -->
<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
    <div class="bg-gradient-to-r from-blue-600 to-blue-800 p-6 text-white">
        <div class="flex justify-between items-start">
            <div>
                <p class="text-blue-200 text-xs uppercase tracking-widest mb-1">Ofertă Comercială</p>
                <h2 class="text-2xl font-bold">@Model.Title</h2>
                <p class="text-blue-100 mt-1">Client: <strong>@Model.ClientName</strong></p>
            </div>
            <div class="text-right">
                <span class="bg-white text-blue-700 font-bold text-lg px-4 py-2 rounded-full">
                    @Model.Discount% OFF
                </span>
            </div>
        </div>
    </div>

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Produse -->
        <div>
            <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-3">Produse incluse</h3>
            <ul class="space-y-2">
                @foreach (var p in Model.Products)
                {
                    <li class="flex items-center gap-2 text-gray-700">
                        <span class="text-green-500 font-bold">✓</span> @p
                    </li>
                }
            </ul>
        </div>

        <!-- Detalii -->
        <div class="space-y-3">
            <div class="flex justify-between py-2 border-b border-gray-100">
                <span class="text-gray-500 text-sm">ID Ofertă</span>
                <code class="text-xs text-gray-700 bg-gray-100 px-2 py-1 rounded">@Model.Id</code>
            </div>
            <div class="flex justify-between py-2 border-b border-gray-100">
                <span class="text-gray-500 text-sm">Discount</span>
                <span class="font-semibold text-green-600">@Model.Discount%</span>
            </div>
            <div class="flex justify-between py-2 border-b border-gray-100">
                <span class="text-gray-500 text-sm">Valabilitate</span>
                <span class="font-semibold text-gray-700">@Model.ValidityDays zile</span>
            </div>
            <div class="flex justify-between py-2 border-b border-gray-100">
                <span class="text-gray-500 text-sm">Creat la</span>
                <span class="text-gray-700 text-sm">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="px-6 pb-6">
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-yellow-800">
                📝 <strong>Note:</strong> @Model.Notes
            </div>
        </div>
    }
</div>

<!-- Cod pattern -->
<div class="mt-8 bg-gray-900 text-gray-100 rounded-xl p-6 text-sm font-mono overflow-x-auto">
    <p class="text-gray-400 text-xs mb-3">// Cod sursă – cum s-a construit această ofertă:</p>
    @if (selectedType == "standard")
    {
        <pre>var director = new OfferDirector(new OfferBuilder());
Offer oferta = director.BuildStandardOffer("@Model.ClientName");
// Discount: 5% | Valabilitate: 30 zile</pre>
    }
    else if (selectedType == "premium")
    {
        <pre>var director = new OfferDirector(new OfferBuilder());
Offer oferta = director.BuildPremiumOffer("@Model.ClientName");
// Discount: 20% | Valabilitate: 90 zile | 5 module</pre>
    }
    else
    {
        <pre>var director = new OfferDirector(new OfferBuilder());
Offer oferta = director.BuildCustomOffer(
    "Oferta Personalizata", "@Model.ClientName",
    new[] { "Modul A", "Modul B", "Modul C" },
    discount: 12, validityDays: 45);</pre>
    }
</div>
