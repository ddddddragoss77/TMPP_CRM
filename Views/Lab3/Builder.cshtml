@model TMPP_CRM.Domain.Builders.Offer
@{
    ViewData["Title"] = "Generator Ofertă";
    var selectedType = ViewBag.SelectedType as string ?? "standard";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-receipt text-blue-600 mr-3 text-3xl"></i>
            Generator Oferte Comerciale
        </h1>
        <p class="text-gray-500 mt-1">Configurează și exportă pachete de servicii pentru clienți.</p>
    </div>
</div>

<!-- Selectare tip oferta -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-8 flex flex-col md:flex-row items-center justify-between">
    <div class="text-sm font-medium text-gray-600 mb-4 md:mb-0">
        Alege șablonul de configurare:
    </div>
    <div class="flex gap-3">
        @foreach (var t in new[] { ("standard", "Pachet Standard", "blue"), ("premium", "Pachet Premium", "amber"), ("custom", "Soluție Enterprise", "gray") })
        {
            <a asp-controller="Lab3" asp-action="Builder" asp-route-type="@t.Item1"
               class="px-5 py-2.5 rounded-lg font-medium text-sm transition duration-200 flex items-center @(selectedType == t.Item1 ? $"bg-{t.Item3}-500 text-white shadow-md shadow-{t.Item3}-500/30" : "bg-gray-50 text-gray-700 hover:bg-gray-100 border border-gray-200")">
                @if(t.Item1 == "standard") { <i class="ph ph-briefcase mr-2"></i> }
                @if(t.Item1 == "premium") { <i class="ph ph-star mr-2"></i> }
                @if(t.Item1 == "custom") { <i class="ph ph-buildings mr-2"></i> }
                @t.Item2
            </a>
        }
    </div>
</div>

<!-- Rezultat oferta -->
<div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden max-w-4xl mx-auto">
    <div class="bg-gradient-to-r from-gray-900 to-gray-800 p-8 text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 -mt-8 -mr-8 w-32 h-32 bg-white opacity-5 rounded-full blur-2xl"></div>
        <div class="flex justify-between items-start relative z-10">
            <div>
                <p class="text-gray-400 text-xs uppercase tracking-widest mb-1 font-semibold">Propunere Comercială</p>
                <h2 class="text-3xl font-bold mb-2">@Model.Title</h2>
                <p class="text-gray-300">Generată pentru: <strong class="text-white">@Model.ClientName</strong></p>
            </div>
            <div class="text-right">
                <span class="bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-bold px-4 py-2 rounded-xl flex items-center">
                    <i class="ph ph-tag mr-2 text-lg"></i>
                    @Model.Discount% DISCOUNT
                </span>
            </div>
        </div>
    </div>

    <div class="p-8 grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Produse -->
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100">
            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest mb-4 flex items-center">
                <i class="ph ph-package text-blue-500 mr-2 text-lg"></i>
                Produse și Servicii
            </h3>
            <ul class="space-y-3">
                @foreach (var p in Model.Products)
                {
                    <li class="flex items-center text-gray-700 font-medium">
                        <i class="ph ph-check-circle text-emerald-500 mr-3 text-lg"></i> @p
                    </li>
                }
            </ul>
        </div>

        <!-- Detalii -->
        <div>
            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-widest mb-4">Condiții Comerciale</h3>
            <div class="space-y-4">
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                    <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-hash mr-2"></i> ID Referință</span>
                    <code class="text-xs font-bold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-md">@Model.Id</code>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                    <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-percent mr-2"></i> Reducere Aplicată</span>
                    <span class="font-bold text-emerald-600">@Model.Discount%</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                    <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-calendar-blank mr-2"></i> Valabilitate</span>
                    <span class="font-bold text-gray-900">@Model.ValidityDays zile</span>
                </div>
                <div class="flex justify-between items-center py-2 border-b border-gray-50">
                    <span class="text-gray-500 text-sm flex items-center"><i class="ph ph-clock mr-2"></i> Data emiterii</span>
                    <span class="text-gray-900 text-sm font-medium">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="px-8 pb-8">
            <div class="bg-yellow-50 border border-yellow-100 rounded-xl p-4 text-sm text-yellow-800 flex">
                <i class="ph ph-info text-yellow-600 mr-3 text-xl"></i>
                <div>
                    <strong class="block mb-1 text-yellow-900">Note interne & Termeni:</strong> 
                    @Model.Notes
                </div>
            </div>
        </div>
    }
    
    <div class="bg-gray-50 p-6 border-t border-gray-100 flex justify-end">
        <button class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl font-medium shadow-sm flex items-center transition-colors">
            <i class="ph ph-paper-plane-right mr-2 text-lg"></i>
            Trimite Clientului
        </button>
    </div>
</div>
