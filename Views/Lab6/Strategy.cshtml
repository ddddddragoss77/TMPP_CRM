@model TMPP_CRM.Controllers.StrategyViewModel
@{
    ViewData["Title"] = "Motor Reduceri — Pattern Strategy";
    var stages = new[] { "New","Contacted","Qualified","ProposalSent","Negotiation","Won","Lost" };
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 flex items-center">
        <i class="ph ph-percent text-blue-600 mr-3 text-3xl"></i>
        Motor Dinamic de Discount
    </h1>
    <p class="text-gray-500 mt-1">Aplică algoritmi de reducere inter-schimbabili pe deal-uri reale din baza de date.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
    <!-- Form -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
                <h3 class="font-bold text-gray-800 flex items-center"><i class="ph ph-sliders mr-2 text-blue-500"></i> Configurare Calcul</h3>
            </div>
            <form method="post" asp-action="Strategy" class="p-6 space-y-5">
                @Html.AntiForgeryToken()

                <!-- Deal din DB -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Deal din baza de date</label>
                    <select asp-for="SelectedDealId" class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none">
                        <option value="@Guid.Empty">— Introdu manual —</option>
                        @foreach (var d in Model.Deals)
                        {
                            <option value="@d.Id">@d.Title (@d.Value.ToString("N0") lei)</option>
                        }
                    </select>
                </div>

                <div class="border-t border-dashed border-gray-200 pt-4">
                    <p class="text-xs text-gray-400 mb-3">Sau introdu manual:</p>
                    <div class="space-y-3">
                        <div>
                            <label asp-for="DealTitle" class="block text-xs font-bold text-gray-500 mb-1">Titlu deal</label>
                            <input asp-for="DealTitle" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
                        </div>
                        <div>
                            <label asp-for="DealValue" class="block text-xs font-bold text-gray-500 mb-1">Valoare (lei)</label>
                            <input asp-for="DealValue" type="number" step="0.01" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
                        </div>
                    </div>
                </div>

                <div class="border-t border-dashed border-gray-200 pt-4 space-y-3">
                    <div>
                        <label asp-for="PercentageRate" class="block text-xs font-bold text-gray-500 mb-1">Reducere procentuală (%)</label>
                        <input asp-for="PercentageRate" type="number" step="0.1" min="0" max="100" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
                    </div>
                    <div>
                        <label asp-for="FixedAmount" class="block text-xs font-bold text-gray-500 mb-1">Reducere sumă fixă (lei)</label>
                        <input asp-for="FixedAmount" type="number" step="0.01" min="0" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-400 outline-none" />
                    </div>
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-md shadow-blue-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-calculator mr-2 text-lg"></i> Calculează Strategiile
                </button>
            </form>
        </div>
    </div>

    <!-- Results -->
    <div class="lg:col-span-3">
        @if (Model.HasResult)
        {
            <div class="bg-gray-900 rounded-2xl p-6 text-white mb-6 border border-gray-800">
                <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Deal procesat</p>
                <h2 class="text-2xl font-bold">@Model.DealTitle</h2>
                <p class="text-emerald-400 text-xl mt-1">Valoare brută: <strong>@Model.DealValue.ToString("N2") lei</strong></p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                @foreach (var item in new[] {
                    ("Fără Reducere",         "A1", Model.NoDiscountResult,  "blue",   "ph-prohibit",        "Prețul integral — nicio politică aplicată"),
                    ($"{Model.PercentageRate}% Reducere", "A2", Model.PercentageResult, "purple", "ph-percent",         $"Scade {Model.PercentageRate}% din valoare"),
                    ($"{Model.FixedAmount:N0} lei Fix", "A3", Model.FixedResult,      "emerald","ph-currency-dollar",  $"Scade fix {Model.FixedAmount:N0} lei")
                })
                {
                    <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <span class="w-8 h-8 rounded-full bg-@item.Item4-50 text-@item.Item4-600 flex items-center justify-center text-xs font-bold">@item.Item2</span>
                            <i class="ph @item.Item5 text-xl text-@item.Item4-400"></i>
                        </div>
                        <h4 class="font-bold text-gray-800 text-sm mb-1">@item.Item1</h4>
                        <p class="text-xs text-gray-500 mb-3">@item.Item6</p>
                        <div class="text-2xl font-bold text-@item.Item4-600">@item.Item3.ToString("N2") lei</div>
                        @if (item.Item3 < Model.DealValue)
                        {
                            <p class="text-xs text-emerald-600 mt-1">Economie: @((Model.DealValue - item.Item3).ToString("N2")) lei</p>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="h-full min-h-[300px] flex items-center justify-center bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                <div class="text-center text-gray-400">
                    <i class="ph ph-percent text-6xl mb-3 block opacity-30"></i>
                    <p class="font-medium">Selectează un deal din DB sau introdu manual,<br>apoi apasă <strong>Calculează</strong>.</p>
                </div>
            </div>
        }
    </div>
</div>
