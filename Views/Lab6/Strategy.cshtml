@model TMPP_CRM.Domain.Entities.Deal
@{
    ViewData["Title"] = "Politici Comerciale (Motor Reduceri)";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-percent text-blue-600 mr-3 text-3xl"></i>
            Motor Dinamic de Discount
        </h1>
        <p class="text-gray-500 mt-1">Algoritmii de calcul pentru oferte sunt decuplați, permițând comutarea politicilor la runtime.</p>
    </div>
</div>

<div class="bg-white border border-gray-100 rounded-xl p-6 mb-8 text-sm text-gray-600 shadow-sm flex items-start gap-4">
    <i class="ph ph-calculator text-blue-500 text-2xl"></i>
    <div>
        <strong class="text-gray-800">Comportament Inter-schimbabil:</strong>
        În loc să avem block-uri mari de reguli fixe pentru a calcula reducerile (ex: de Black Friday, client fidel etc.), fiecare metodă de calcul este un obiect separat. Sistemul decide în timp real ce formulă matematică să folosească pentru tranzacția curentă.
    </div>
</div>

<div class="bg-gray-900 rounded-2xl shadow-lg border border-gray-800 overflow-hidden mb-8">
    <div class="p-8 flex flex-col md:flex-row items-center justify-between">
        <div class="flex items-center mb-6 md:mb-0">
            <div class="w-16 h-16 bg-blue-500/20 text-blue-400 rounded-2xl flex items-center justify-center mr-6 border border-blue-500/30">
                <i class="ph ph-handshake text-3xl"></i>
            </div>
            <div>
                <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Contract Curent</p>
                <h2 class="text-2xl font-bold text-white">@Model.Title</h2>
            </div>
        </div>
        
        <div class="text-center md:text-right bg-gray-800 p-4 rounded-xl border border-gray-700">
            <p class="text-xs text-gray-400 font-bold uppercase tracking-wider mb-1">Valoare Brută Bază</p>
            <span class="text-3xl tracking-tight text-emerald-400">@ViewBag.OriginalValue.ToString("C")</span>
        </div>
    </div>
</div>

<h3 class="text-lg font-bold text-gray-800 mb-6 flex items-center">
    <i class="ph ph-math-operations mr-2 text-blue-500"></i> Rezultate Algoritmi Inter-schimbabili
</h3>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Algoritm 1 -->
    <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <i class="ph ph-percent text-6xl text-blue-500"></i>
        </div>
        <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mb-4 border border-blue-100">
            <span class="font-bold tracking-tight">A1</span>
        </div>
        <h4 class="font-bold text-gray-800 mb-1">Politică Procentuală</h4>
        <p class="text-xs text-gray-500 mb-6 h-8">Formulă: Scade 10% din total. (Utilizată pt. clienți fideli).</p>
        
        <div class="pt-4 border-t border-gray-100">
            <span class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Total Calculat</span>
            <div class="text-2xl tracking-tight text-blue-600 font-bold">
                @ViewBag.PercentageDiscount.ToString("C")
            </div>
        </div>
    </div>

    <!-- Algoritm 2 -->
    <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <i class="ph ph-currency-dollar text-6xl text-purple-500"></i>
        </div>
        <div class="w-10 h-10 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center mb-4 border border-purple-100">
            <span class="font-bold tracking-tight">A2</span>
        </div>
        <h4 class="font-bold text-gray-800 mb-1">Politică Sumă Fixă</h4>
        <p class="text-xs text-gray-500 mb-6 h-8">Formulă: Scade 150$ per contract. (Promoție fixă sezonieră).</p>
        
        <div class="pt-4 border-t border-gray-100">
            <span class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Total Calculat</span>
            <div class="text-2xl tracking-tight text-purple-600 font-bold">
                @ViewBag.FixedDiscount.ToString("C")
            </div>
        </div>
    </div>

    <!-- Algoritm 3 -->
    <div class="bg-white border border-gray-200 rounded-2xl p-6 hover:shadow-md transition-shadow relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <i class="ph ph-prohibit text-6xl text-gray-500"></i>
        </div>
        <div class="w-10 h-10 rounded-full bg-gray-100 text-gray-600 flex items-center justify-center mb-4 border border-gray-200">
            <span class="font-bold tracking-tight">A3</span>
        </div>
        <h4 class="font-bold text-gray-800 mb-1">Nicio Politică (Default)</h4>
        <p class="text-xs text-gray-500 mb-6 h-8">Formulă: Returnează prețul brut. (Clienți noi standard).</p>
        
        <div class="pt-4 border-t border-gray-100">
            <span class="block text-[10px] uppercase font-bold text-gray-400 mb-1">Total Calculat</span>
            <div class="text-2xl tracking-tight text-gray-700 font-bold">
                @ViewBag.NoDiscount.ToString("C")
            </div>
        </div>
    </div>
</div>
