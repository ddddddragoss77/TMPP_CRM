@model TMPP_CRM.Controllers.IteratorViewModel
@{
    ViewData["Title"] = "Iterator — Procesare Loturi";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 flex items-center">
        <i class="ph ph-list-numbers text-amber-600 mr-3 text-3xl"></i>
        Iterare Deal-uri Reale din Baza de Date
    </h1>
    <p class="text-gray-500 mt-1">Filtrează și parcurge deal-urile CRM real prin interfața uniformă <code>HasNext()</code> / <code>Next()</code>.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Filtre -->
    <div class="lg:col-span-3">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <h3 class="font-bold text-gray-800 mb-4 flex items-center border-b border-gray-100 pb-3 text-sm">
                <i class="ph ph-funnel mr-2 text-amber-500"></i> Filtre
            </h3>
            <form method="post" asp-action="Iterator" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label asp-for="FilterTitle" class="block text-xs font-bold text-gray-500 mb-1">Titlu conține</label>
                    <input asp-for="FilterTitle" placeholder="ex: CRM, Cloud..." class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-amber-400 outline-none" />
                </div>
                <div>
                    <label asp-for="MinValue" class="block text-xs font-bold text-gray-500 mb-1">Valoare minimă (lei)</label>
                    <input asp-for="MinValue" type="number" step="100" min="0" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-amber-400 outline-none" />
                </div>

                <button type="submit" class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-2.5 rounded-xl transition-colors text-sm flex justify-center items-center">
                    <i class="ph ph-play mr-2"></i> Lansează Iteratorul
                </button>
            </form>
        </div>

        @if (Model.HasResult)
        {
            <div class="mt-4 bg-gray-900 rounded-2xl p-5 border border-gray-800 text-sm space-y-3">
                <div class="text-amber-400 font-mono text-xs">▶ DealCollection.CreateIterator()</div>
                <div class="text-gray-400 font-mono text-xs">  Total: @Model.TotalCount obiecte</div>
                <div class="text-gray-400 font-mono text-xs">  Valoare totală: @Model.TotalValue.ToString("N0") lei</div>
                <div class="text-emerald-400 font-mono text-xs">✓ Iterator parcurs complet</div>
            </div>
        }
    </div>

    <!-- Tabel rezultate -->
    <div class="lg:col-span-9">
        @if (!Model.HasResult)
        {
            <div class="h-full min-h-[300px] flex items-center justify-center bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                <div class="text-center text-gray-400">
                    <i class="ph ph-list-numbers text-6xl mb-3 block opacity-30"></i>
                    <p class="font-medium">Apasă <strong>Lansează Iteratorul</strong> pentru a parcurge deal-urile din DB.</p>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="bg-gray-50 border-b border-gray-200 px-5 py-3 flex justify-between items-center">
                    <h3 class="font-bold text-gray-800 flex items-center text-sm">
                        <i class="ph ph-database mr-2 text-amber-500"></i> Deal-uri Extrase din SQLite (@Model.TotalCount)
                    </h3>
                    <div class="flex gap-3 text-xs text-gray-500">
                        <span>Filtru titlu: <strong class="text-gray-800">@(string.IsNullOrEmpty(Model.FilterTitle) ? "—" : Model.FilterTitle)</strong></span>
                        <span>Min val: <strong class="text-gray-800">@(Model.MinValue > 0 ? Model.MinValue.ToString("N0") + " lei" : "—")</strong></span>
                    </div>
                </div>

                @if (!Model.IteratedDeals.Any())
                {
                    <div class="p-8 text-center text-gray-500">
                        <i class="ph ph-magnifying-glass text-4xl mb-3 block opacity-30"></i>
                        <p>Niciun deal nu corespunde filtrelor aplicate.</p>
                    </div>
                }
                else
                {
                    <table class="w-full text-sm text-left">
                        <thead class="text-xs text-gray-500 uppercase bg-gray-50 border-b border-gray-100">
                            <tr>
                                <th class="px-5 py-3">Index</th>
                                <th class="px-5 py-3">Deal (Obiect extras)</th>
                                <th class="px-5 py-3 text-right">Valoare</th>
                                <th class="px-5 py-3 text-right">Status Iterator</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            @foreach (var d in Model.IteratedDeals)
                            {
                                <tr class="hover:bg-amber-50/30 transition-colors group">
                                    <td class="px-5 py-3 text-gray-400 font-mono text-xs">[@d.Index]</td>
                                    <td class="px-5 py-3 font-semibold text-gray-800 flex items-center">
                                        <i class="ph ph-briefcase mr-2 text-amber-500 opacity-50 group-hover:opacity-100 transition-opacity"></i>
                                        @d.Title
                                    </td>
                                    <td class="px-5 py-3 text-right font-medium text-gray-900">@d.Value.ToString("N0") lei</td>
                                    <td class="px-5 py-3 text-right">
                                        @if (d.HasNext)
                                        {
                                            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-emerald-100 text-emerald-700">HAS_NEXT: TRUE</span>
                                        }
                                        else
                                        {
                                            <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-red-100 text-red-600">END_OF_COLLECTION</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="border-t border-gray-200 bg-gray-50">
                            <tr>
                                <td colspan="2" class="px-5 py-3 text-xs text-gray-500">@Model.TotalCount deal-uri parcurse</td>
                                <td class="px-5 py-3 text-right font-bold text-gray-900">@Model.TotalValue.ToString("N0") lei</td>
                                <td class="px-5 py-3 text-right text-xs text-gray-500">Total</td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        }
    </div>
</div>
