@model TMPP_CRM.Controllers.MementoViewModel
@{
    ViewData["Title"] = "Memento — Snapshot & Restore";
    var statuses = new[] { "New", "Contacted", "Qualified", "Converted", "Lost" };
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 flex items-center">
        <i class="ph ph-floppy-disk text-rose-600 mr-3 text-3xl"></i>
        Snapshot & Rollback Lead — Date Reale
    </h1>
    <p class="text-gray-500 mt-1">Editează lead-uri reale din baza de date. Snapshot-ul este salvat înainte de fiecare modificare — poți restaura oricând.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Form editare -->
    <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="bg-gray-50 border-b border-gray-200 px-6 py-4">
                <h3 class="font-bold text-gray-800 flex items-center"><i class="ph ph-pencil-simple mr-2 text-rose-500"></i> Editare Lead Real</h3>
            </div>
            <form method="post" asp-action="Memento" class="p-6 space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Selectează Lead</label>
                    <select asp-for="LeadId" class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-rose-400 outline-none">
                        @foreach (var l in Model.Leads)
                        {
                            <option value="@l.Id">@l.FirstName @l.LastName (@l.Status)</option>
                        }
                    </select>
                </div>

                <p class="text-xs text-gray-400 pt-2 border-t border-dashed border-gray-200">Câmpurile de mai jos înlocuiesc valorile curente (lasă gol pentru a păstra):</p>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label asp-for="NewFirstName" class="block text-xs text-gray-500 mb-1">Prenume nou</label>
                        <input asp-for="NewFirstName" placeholder="ex: Ion" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-rose-400 outline-none" />
                    </div>
                    <div>
                        <label asp-for="NewLastName" class="block text-xs text-gray-500 mb-1">Nume nou</label>
                        <input asp-for="NewLastName" placeholder="ex: Popescu" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-rose-400 outline-none" />
                    </div>
                </div>
                <div>
                    <label asp-for="NewEmail" class="block text-xs text-gray-500 mb-1">Email nou</label>
                    <input asp-for="NewEmail" placeholder="ex: nou@email.com" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-rose-400 outline-none" />
                </div>
                <div>
                    <label asp-for="NewPhone" class="block text-xs text-gray-500 mb-1">Telefon nou</label>
                    <input asp-for="NewPhone" placeholder="ex: +40712345678" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-rose-400 outline-none" />
                </div>
                <div>
                    <label asp-for="NewStatus" class="block text-xs text-gray-500 mb-1">Status nou</label>
                    <select asp-for="NewStatus" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-rose-400 outline-none">
                        <option value="">— Păstrează curent —</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

                <button type="submit" class="w-full bg-rose-600 hover:bg-rose-700 text-white font-bold py-3 rounded-xl shadow-md shadow-rose-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-floppy-disk mr-2 text-lg"></i> Salvează Modificarea (cu Snapshot)
                </button>
            </form>
        </div>

        @if (Model.HasResult)
        {
            <div class="mt-5 grid grid-cols-1 gap-3">
                @foreach (var (label, value, color) in new[] {
                    ("📸 Snapshot (înainte)", Model.SnapshotState, "gray"),
                    ("✏️ Modificat (salvat)", Model.ModifiedState, "blue")
                })
                {
                    <div class="bg-@color-50 border border-@color-200 rounded-xl p-4">
                        <p class="text-xs font-bold text-@color-600 uppercase tracking-widest mb-2">@label</p>
                        <p class="text-sm font-mono text-@color-800">@value</p>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Snapshots în DB -->
    <div class="lg:col-span-7">
        <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden h-full">
            <div class="bg-gray-950 px-5 py-4 border-b border-gray-800 flex items-center justify-between">
                <h4 class="text-sm font-bold text-gray-300 flex items-center">
                    <i class="ph ph-stack mr-2 text-rose-400"></i> Snapshots Salvate în DB (@Model.Snapshots.Count)
                </h4>
                <span class="text-xs text-gray-500">Click Restore pentru rollback</span>
            </div>

            @if (!Model.Snapshots.Any())
            {
                <div class="p-8 text-center text-gray-600">
                    <i class="ph ph-floppy-disk text-5xl mb-3 block opacity-20"></i>
                    <p class="text-sm">Niciun snapshot salvat încă.<br>Editează un lead pentru a crea primul snapshot.</p>
                </div>
            }
            else
            {
                <div class="divide-y divide-gray-800 overflow-y-auto max-h-[600px]">
                    @foreach (var snap in Model.Snapshots)
                    {
                        <div class="px-5 py-4 hover:bg-gray-800/50 transition-colors">
                            <div class="flex items-start justify-between mb-2">
                                <div>
                                    <span class="text-white font-bold text-sm">@snap.FirstName @snap.LastName</span>
                                    <span class="ml-2 text-xs bg-gray-800 text-gray-400 px-2 py-0.5 rounded-full">@snap.Label</span>
                                </div>
                                <span class="text-gray-500 text-xs">@snap.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</span>
                            </div>
                            <p class="text-gray-400 text-xs mb-3 font-mono">@snap.Email | @snap.Phone | @snap.Status</p>
                            <form method="post" asp-action="RestoreSnapshot">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="snapshotId" value="@snap.Id" />
                                <button type="submit" class="text-xs bg-rose-900/50 hover:bg-rose-800 text-rose-300 border border-rose-800 px-3 py-1.5 rounded-lg transition-colors flex items-center">
                                    <i class="ph ph-arrow-u-up-left mr-1"></i> Restaurează Lead-ul la această stare
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
