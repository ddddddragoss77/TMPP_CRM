@model TMPP_CRM.Controllers.CommandViewModel
@{
    ViewData["Title"] = "Command — Undo Engine";
    var allStages = new[] { "Contacted","Qualified","ProposalSent","Negotiation","Won","Lost" };
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 flex items-center">
        <i class="ph ph-clock-counter-clockwise text-emerald-600 mr-3 text-3xl"></i>
        Jurnal Operațiuni — Undo Engine
    </h1>
    <p class="text-gray-500 mt-1">Fiecare schimbare de stage pe un deal real este o comandă reversibilă. Audit trail complet salvat în DB.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Form -->
    <div class="lg:col-span-4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="font-bold text-gray-800 mb-5 flex items-center border-b border-gray-100 pb-3">
                <i class="ph ph-gear mr-2 text-emerald-500"></i> Configurare Operațiuni
            </h3>
            <form method="post" asp-action="Command" class="space-y-5">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Deal din baza de date</label>
                    <select asp-for="SelectedDealId" class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-emerald-400 outline-none">
                        <option value="@Guid.Empty">— Manual —</option>
                        @foreach (var d in Model.Deals)
                        {
                            <option value="@d.Id">@d.Title [Stage: @d.Stage]</option>
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="DealTitle" class="block text-xs font-bold text-gray-500 mb-1">Titlu manual</label>
                    <input asp-for="DealTitle" placeholder="ex: Contract Enterprise" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-400 outline-none" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Stage-uri de executat</label>
                    <div class="space-y-1">
                        @foreach (var s in allStages)
                        {
                            <label class="flex items-center p-2 rounded-lg hover:bg-emerald-50 cursor-pointer">
                                <input type="checkbox" name="ExecuteStages" value="@s" class="mr-3 w-4 h-4 accent-emerald-600">
                                <span class="text-sm text-gray-700">@s</span>
                            </label>
                        }
                    </div>
                </div>

                <div>
                    <label asp-for="UndoCount" class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Număr Undo-uri</label>
                    <input asp-for="UndoCount" type="number" min="0" max="10" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-400 outline-none" />
                </div>

                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl shadow-md shadow-emerald-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-play mr-2 text-lg"></i> Execută Comenzile
                </button>
            </form>
        </div>
    </div>

    <!-- Results + DB Log -->
    <div class="lg:col-span-8 space-y-6">
        @if (Model.HasResult)
        {
            <div class="bg-gray-900 rounded-2xl p-5 text-white border border-gray-800 flex justify-between items-center">
                <div>
                    <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">Deal procesat</p>
                    <h2 class="text-xl font-bold">@Model.DealTitle</h2>
                </div>
                <div class="text-right">
                    <p class="text-xs text-gray-400 mb-1">Stage final în DB</p>
                    <span class="text-emerald-400 font-bold text-lg">@Model.FinalStage</span>
                </div>
            </div>

            <!-- Audit trail current session -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="bg-gray-50 border-b border-gray-200 px-5 py-3">
                    <h4 class="font-bold text-gray-800 flex items-center text-sm"><i class="ph ph-list-dashes mr-2 text-emerald-500"></i> Audit Trail — Sesiunea curentă</h4>
                </div>
                <div class="p-5 relative">
                    <div class="absolute left-9 top-5 bottom-5 w-0.5 bg-gray-100"></div>
                    <div class="space-y-4 relative z-10">
                        @foreach (var step in Model.AuditTrail)
                        {
                            var (bg, border, textC, icon) = step.Type switch
                            {
                                "execute" => ("bg-blue-50", "border-blue-200", "text-blue-700", "ph-arrow-circle-right"),
                                "undo"    => ("bg-amber-50", "border-amber-200", "text-amber-700", "ph-arrow-u-up-left"),
                                _         => ("bg-gray-50", "border-gray-200", "text-gray-600", "ph-file-plus")
                            };
                            <div class="flex items-center gap-4">
                                <div class="w-8 h-8 rounded-full border-2 @border bg-white flex items-center justify-center flex-shrink-0">
                                    <i class="ph @icon @textC text-sm"></i>
                                </div>
                                <div class="flex-1 @bg border @border rounded-xl px-4 py-2">
                                    <span class="text-xs font-bold @textC uppercase">@step.Action</span>
                                    <span class="ml-2 text-sm text-gray-800">→ Stage: <strong>@step.Stage</strong></span>
                                    <span class="ml-2 text-xs text-gray-400">(@step.Actor)</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- DB Persistent Log -->
        <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden">
            <div class="bg-gray-950 px-5 py-3 border-b border-gray-800 flex items-center justify-between">
                <h4 class="text-sm font-bold text-gray-300 flex items-center"><i class="ph ph-database mr-2 text-emerald-400"></i> Audit Persistent din DB (@Model.PersistedLog.Count înregistrări)</h4>
            </div>
            <div class="divide-y divide-gray-800 max-h-64 overflow-y-auto">
                @if (!Model.PersistedLog.Any())
                {
                    <div class="p-6 text-center text-gray-600 text-sm">Niciun audit trail salvat încă.</div>
                }
                @foreach (var entry in Model.PersistedLog)
                {
                    var color = entry.Action == "UNDO" ? "text-amber-400" : entry.Action == "EXECUTE" ? "text-blue-400" : "text-gray-400";
                    <div class="px-5 py-2.5 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="@color text-xs font-bold uppercase w-16">@entry.Action</span>
                            <span class="text-gray-300 text-sm">@entry.DealTitle</span>
                            <span class="text-gray-500 text-xs">@entry.PreviousStage → @entry.NewStage</span>
                        </div>
                        <span class="text-gray-600 text-xs">@entry.CreatedAt.ToString("dd.MM HH:mm:ss")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
