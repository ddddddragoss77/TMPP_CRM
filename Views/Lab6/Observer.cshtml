@model TMPP_CRM.Controllers.ObserverViewModel
@{
    ViewData["Title"] = "Observer — Event Bus Live";
    var allStages = new[] { "Contacted","Qualified","ProposalSent","Negotiation","Won","Lost" };
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 flex items-center">
        <i class="ph ph-broadcast text-indigo-600 mr-3 text-3xl"></i>
        Event Bus & Alerte Live
    </h1>
    <p class="text-gray-500 mt-1">Schimbă stage-ul unui deal real și observatorii notifică automat — evenimentele se salvează în baza de date.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Form -->
    <div class="lg:col-span-4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="font-bold text-gray-800 mb-5 flex items-center border-b border-gray-100 pb-3">
                <i class="ph ph-target mr-2 text-indigo-500"></i> Configurare Event
            </h3>
            <form method="post" asp-action="Observer" class="space-y-5">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-1">Deal din baza de date</label>
                    <select asp-for="SelectedDealId" class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-indigo-400 outline-none">
                        <option value="@Guid.Empty">— Introdu manual —</option>
                        @foreach (var d in Model.Deals)
                        {
                            <option value="@d.Id">@d.Title [Stage: @d.Stage]</option>
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="DealTitle" class="block text-xs font-bold text-gray-500 mb-1">Titlu manual (dacă nu din DB)</label>
                    <input asp-for="DealTitle" placeholder="ex: Contract Enterprise" class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-400 outline-none" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Stage-uri de parcurs (în ordine)</label>
                    <div class="space-y-2">
                        @foreach (var s in allStages)
                        {
                            <label class="flex items-center p-2 rounded-lg hover:bg-indigo-50 cursor-pointer">
                                <input type="checkbox" name="Stages" value="@s" class="mr-3 w-4 h-4 accent-indigo-600">
                                <span class="text-sm font-medium text-gray-700">@s</span>
                            </label>
                        }
                    </div>
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl shadow-md shadow-indigo-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-broadcast mr-2 text-lg"></i> Lansează Evenimentele
                </button>
            </form>
        </div>
    </div>

    <!-- Results + History -->
    <div class="lg:col-span-8 space-y-6">
        @if (Model.HasResult)
        {
            <div class="bg-indigo-900 rounded-2xl p-5 text-white border border-indigo-800">
                <p class="text-xs text-indigo-300 uppercase tracking-widest mb-1">Deal procesat</p>
                <h2 class="text-xl font-bold">@Model.DealTitle</h2>
                <p class="text-indigo-300 mt-1">Stage final: <strong class="text-white">@Model.FinalStage</strong></p>
            </div>

            @foreach (var step in Model.Steps)
            {
                <div class="bg-white border border-indigo-200 rounded-2xl overflow-hidden shadow-sm">
                    <div class="bg-indigo-50 border-b border-indigo-100 px-5 py-3 flex justify-between items-center">
                        <span class="font-bold text-indigo-800 text-sm flex items-center">
                            <i class="ph ph-lightning mr-2"></i> Stage → @step.Stage
                        </span>
                        <span class="text-xs text-indigo-500">2 subscribers fired</span>
                    </div>
                    <div class="p-5">
                        <pre class="text-sm bg-indigo-50 text-indigo-900 p-4 rounded-xl whitespace-pre-wrap font-mono leading-relaxed">@step.Log</pre>
                    </div>
                </div>
            }
        }

        <!-- DB Log -->
        <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden">
            <div class="bg-gray-950 px-5 py-3 border-b border-gray-800 flex items-center justify-between">
                <h4 class="text-sm font-bold text-gray-300 flex items-center"><i class="ph ph-database mr-2 text-indigo-400"></i> Istoric Evenimente din DB (@Model.EventLog.Count)</h4>
                <span class="text-xs text-gray-500">Ultimele 20</span>
            </div>
            <div class="divide-y divide-gray-800 max-h-64 overflow-y-auto">
                @if (!Model.EventLog.Any())
                {
                    <div class="p-6 text-center text-gray-600 text-sm">Niciun eveniment salvat încă.</div>
                }
                @foreach (var evt in Model.EventLog)
                {
                    <div class="px-5 py-3 flex items-center justify-between">
                        <div>
                            <span class="text-white text-sm font-medium">@evt.DealTitle</span>
                            <span class="ml-2 text-xs bg-indigo-900 text-indigo-300 px-2 py-0.5 rounded-full">→ @evt.NewStage</span>
                        </div>
                        <span class="text-gray-500 text-xs">@evt.CreatedAt.ToString("dd.MM HH:mm:ss")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
