@model TMPP_CRM.Controllers.DecoratorViewModel

@{
    ViewData["Title"] = "Decorator Pattern Demo";
}

<div class="mb-6">
    <a asp-controller="Lab5" asp-action="Index" class="text-emerald-600 hover:text-emerald-800 font-medium">&larr; Înapoi la Laborator 5</a>
</div>

<div class="bg-white rounded-2xl shadow-lg p-8 max-w-2xl mx-auto border border-gray-100">
    <h1 class="text-3xl font-bold text-gray-800 mb-6 flex items-center">
        <span class="text-4xl mr-3">🎁</span> Decorator Pattern Demo
    </h1>

    <form method="get" asp-action="Decorator" class="mb-8 bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h3 class="text-lg font-semibold mb-4 text-gray-700">Selectează Decoratorii de Notificare</h3>
        
        <div class="flex items-center space-x-6 mb-4">
            <label class="flex items-center space-x-2 cursor-pointer">
                <input type="checkbox" checked disabled class="form-checkbox h-5 w-5 text-emerald-600 rounded">
                <span class="text-gray-700 font-medium">Email (Bază)</span>
            </label>
            
            <label class="flex items-center space-x-2 cursor-pointer">
                <input type="checkbox" name="useSms" value="true" @(Model.UseSms ? "checked" : "") class="form-checkbox h-5 w-5 text-emerald-600 rounded">
                <span class="text-gray-700 font-medium">+ SMS Decorator</span>
            </label>
            
            <label class="flex items-center space-x-2 cursor-pointer">
                <input type="checkbox" name="usePush" value="true" @(Model.UsePush ? "checked" : "") class="form-checkbox h-5 w-5 text-emerald-600 rounded">
                <span class="text-gray-700 font-medium">+ Push Decorator</span>
            </label>
        </div>
        
        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-6 rounded-lg transition duration-200 shadow-md">
            Trimite Notificare
        </button>
    </form>

    <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-6">
        <h3 class="text-sm font-semibold text-emerald-800 mb-2 uppercase tracking-wider">Rezultat Execuție:</h3>
        <pre class="whitespace-pre-wrap font-mono text-emerald-900 bg-emerald-100/50 p-4 rounded-lg">@Model.Result</pre>
    </div>
</div>
