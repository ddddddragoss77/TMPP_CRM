@model TMPP_CRM.Controllers.BridgeInputViewModel

@{
    ViewData["Title"] = "Modul Media Streaming";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-monitor-play text-amber-600 mr-3 text-3xl"></i>
            Media Streaming Integrat
        </h1>
        <p class="text-gray-500 mt-1">Platforma decuplează formatele fișierelor (Audio/Video) de hardware-ul redării (Mobile/TV), asigurând scalabilitate maximă.</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controale -->
    <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="font-bold text-gray-800 mb-6 flex items-center border-b border-gray-100 pb-3">
                <i class="ph ph-sliders mr-2 text-amber-500"></i> Parametri Redare
            </h3>

            <form method="post" asp-action="Bridge" class="space-y-6">
                @Html.AntiForgeryToken()

                <!-- Sursa Media -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wider text-xs">1. Tip Fișier Media</label>
                    <div class="grid grid-cols-2 gap-3">
                        @foreach (var m in new[] {
                            ("Video", "Cameră Securitate", "ph-video-camera"),
                            ("Audio", "Call Center MP3",   "ph-headphones")
                        })
                        {
                            <label class="cursor-pointer">
                                <input type="radio" name="MediaType" value="@m.Item1" class="peer sr-only"
                                       @(Model.MediaType == m.Item1 ? "checked" : "")>
                                <div class="flex flex-col items-center justify-center p-4 border-2 rounded-xl transition-all peer-checked:border-amber-500 peer-checked:bg-amber-50 hover:bg-gray-50 @(Model.MediaType == m.Item1 ? "border-amber-500 bg-amber-50" : "border-gray-200")">
                                    <i class="ph @m.Item3 text-2xl mb-1 @(Model.MediaType == m.Item1 ? "text-amber-600" : "text-gray-400")"></i>
                                    <span class="text-sm font-bold @(Model.MediaType == m.Item1 ? "text-amber-800" : "text-gray-600")">@m.Item2</span>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Hardware -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wider text-xs">2. Hardware Țintă</label>
                    <div class="grid grid-cols-2 gap-3">
                        @foreach (var d in new[] {
                            ("Tv",    "Consolă Web (4K)",    "ph-television"),
                            ("Phone", "Aplicație Nativă OS", "ph-device-mobile")
                        })
                        {
                            <label class="cursor-pointer">
                                <input type="radio" name="DeviceType" value="@d.Item1" class="peer sr-only"
                                       @(Model.DeviceType == d.Item1 ? "checked" : "")>
                                <div class="flex items-center p-3 border-2 rounded-xl transition-all peer-checked:border-indigo-500 peer-checked:bg-indigo-50 hover:bg-gray-50 @(Model.DeviceType == d.Item1 ? "border-indigo-500 bg-indigo-50" : "border-gray-200")">
                                    <i class="ph @d.Item3 text-xl mr-3 @(Model.DeviceType == d.Item1 ? "text-indigo-600" : "text-gray-400")"></i>
                                    <span class="text-sm font-bold @(Model.DeviceType == d.Item1 ? "text-indigo-800" : "text-gray-600")">@d.Item2</span>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Filename -->
                <div>
                    <label asp-for="FileName" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">3. Nume Fișier (opțional)</label>
                    <input asp-for="FileName" placeholder="ex: reuniune_board_q2.mp4"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-amber-400 outline-none transition" />
                    <p class="text-xs text-gray-400 mt-1">Lasă gol pentru a folosi numele implicit.</p>
                </div>

                <button type="submit"
                        class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 px-6 rounded-xl shadow-md shadow-amber-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-play mr-2 text-lg"></i> Redă Media
                </button>
            </form>
        </div>
    </div>

    <!-- Player -->
    <div class="lg:col-span-7">
        <div class="bg-gray-900 rounded-2xl shadow-xl overflow-hidden h-full min-h-[360px] flex flex-col relative border border-gray-800">
            <!-- Header -->
            <div class="bg-gray-950 px-4 py-3 flex justify-between items-center border-b border-gray-800">
                <div class="flex items-center space-x-2">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <div class="text-xs tracking-wide text-gray-500 flex items-center">
                    <i class="ph ph-lock-key mr-1"></i> AES-256 Encrypted Stream
                </div>
            </div>

            <!-- Body -->
            <div class="flex-grow flex items-center justify-center p-8 relative">
                @if (Model.HasResult)
                {
                    <div class="relative z-10 text-center w-full">
                        <div class="w-24 h-24 rounded-full bg-amber-500/20 flex items-center justify-center mx-auto mb-6 shadow-[0_0_30px_rgba(245,158,11,0.3)] border border-amber-500/50 relative">
                            @if (Model.MediaType == "Video")
                            {
                                <i class="ph ph-play-circle text-5xl text-amber-400"></i>
                            }
                            else
                            {
                                <i class="ph ph-waveform text-5xl text-amber-400"></i>
                                <div class="absolute -right-2 -top-2 w-6 h-6 bg-red-500 rounded-full animate-ping"></div>
                                <div class="absolute -right-2 -top-2 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center text-[10px] text-white font-bold">REC</div>
                            }
                        </div>

                        <h2 class="text-2xl font-bold text-white mb-4 tracking-wide">LIVE FEED</h2>

                        <div class="inline-block bg-gray-800/80 backdrop-blur-sm border border-gray-700 px-6 py-3 rounded-xl max-w-md">
                            <p class="text-amber-400 font-medium tracking-wide text-sm">@Model.Result</p>
                        </div>

                        <div class="mt-4 flex justify-center gap-4 text-xs text-gray-500">
                            <span class="bg-gray-800 px-3 py-1 rounded-full">Tip: @Model.MediaType</span>
                            <span class="bg-gray-800 px-3 py-1 rounded-full">Dispozitiv: @Model.DeviceType</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center text-gray-600">
                        <i class="ph ph-monitor-play text-6xl mb-3 block opacity-30"></i>
                        <p class="text-sm">Alege tipul media și dispozitivul,<br>apoi apasă <strong class="text-gray-400">Redă Media</strong>.</p>
                    </div>
                }
            </div>

            <!-- Footer Controls -->
            <div class="bg-gray-950/80 backdrop-blur-md px-6 py-4 border-t border-gray-800 flex items-center justify-between">
                <div class="flex items-center space-x-4 text-gray-400 text-xl">
                    <i class="ph ph-play-pause hover:text-white cursor-pointer transition-colors"></i>
                    <i class="ph ph-skip-forward hover:text-white cursor-pointer transition-colors"></i>
                    <i class="ph ph-speaker-high hover:text-white cursor-pointer transition-colors"></i>
                </div>
                <div class="flex-grow mx-6">
                    <div class="h-1.5 w-full bg-gray-800 rounded-full overflow-hidden">
                        @if (Model.HasResult)
                        {
                            <div class="h-full bg-amber-500 w-1/3 animate-pulse"></div>
                        }
                        else
                        {
                            <div class="h-full bg-gray-700 w-0"></div>
                        }
                    </div>
                </div>
                <div class="text-xs tracking-wide text-amber-500/70">
                    <i class="ph ph-broadcast"></i> @(Model.DeviceType == "Tv" ? "HD_STREAM" : "LQ_MOBILE")
                </div>
            </div>
        </div>
    </div>
</div>
