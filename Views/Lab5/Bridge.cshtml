@model TMPP_CRM.Controllers.BridgeViewModel

@{
    ViewData["Title"] = "Modul Media Streaming";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-monitor-play text-amber-600 mr-3 text-3xl"></i>
            Media Streaming Integrat
        </h1>
        <p class="text-gray-500 mt-1">Platforma decuplează formatele fișierelor (Audio/Video) de hardware-ul redării (Mobile/Web), asigurând scalabilitate maximă.</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controale -->
    <div class="lg:col-span-5">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="font-bold text-gray-800 mb-6 flex items-center border-b border-gray-100 pb-3">
                <i class="ph ph-sliders mr-2 text-amber-500"></i> Parametri Redare
            </h3>
            
            <form method="get" asp-action="Bridge" class="space-y-6">
                <!-- Sursa Media -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wider text-xs">1. Sursă Fișier</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer">
                            <input type="radio" name="mediaType" value="Video" class="peer sr-only" @(Model.MediaType == "Video" ? "checked" : "") onchange="this.form.submit()">
                            <div class="flex flex-col items-center justify-center p-4 border-2 rounded-xl transition-all peer-checked:border-amber-500 peer-checked:bg-amber-50 hover:bg-gray-50 @(Model.MediaType == "Video" ? "border-amber-500 bg-amber-50" : "border-gray-200")">
                                <i class="ph ph-video-camera text-2xl mb-1 @(Model.MediaType == "Video" ? "text-amber-600" : "text-gray-400")"></i>
                                <span class="text-sm font-bold @(Model.MediaType == "Video" ? "text-amber-800" : "text-gray-600")">Cameră Securitate</span>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="mediaType" value="Audio" class="peer sr-only" @(Model.MediaType == "Audio" ? "checked" : "") onchange="this.form.submit()">
                            <div class="flex flex-col items-center justify-center p-4 border-2 rounded-xl transition-all peer-checked:border-amber-500 peer-checked:bg-amber-50 hover:bg-gray-50 @(Model.MediaType == "Audio" ? "border-amber-500 bg-amber-50" : "border-gray-200")">
                                <i class="ph ph-headphones text-2xl mb-1 @(Model.MediaType == "Audio" ? "text-amber-600" : "text-gray-400")"></i>
                                <span class="text-sm font-bold @(Model.MediaType == "Audio" ? "text-amber-800" : "text-gray-600")">Call Center MP3</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Dispozitiv Redare -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-3 uppercase tracking-wider text-xs">2. Hardware Țintă</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer">
                            <input type="radio" name="deviceType" value="Tv" class="peer sr-only" @(Model.DeviceType == "Tv" ? "checked" : "") onchange="this.form.submit()">
                            <div class="flex items-center p-3 border-2 rounded-xl transition-all peer-checked:border-indigo-500 peer-checked:bg-indigo-50 hover:bg-gray-50 @(Model.DeviceType == "Tv" ? "border-indigo-500 bg-indigo-50" : "border-gray-200")">
                                <i class="ph ph-television text-xl mr-3 @(Model.DeviceType == "Tv" ? "text-indigo-600" : "text-gray-400")"></i>
                                <span class="text-sm font-bold @(Model.DeviceType == "Tv" ? "text-indigo-800" : "text-gray-600")">Consolă Web (4K)</span>
                            </div>
                        </label>
                        <label class="cursor-pointer">
                            <input type="radio" name="deviceType" value="Phone" class="peer sr-only" @(Model.DeviceType == "Phone" ? "checked" : "") onchange="this.form.submit()">
                            <div class="flex items-center p-3 border-2 rounded-xl transition-all peer-checked:border-indigo-500 peer-checked:bg-indigo-50 hover:bg-gray-50 @(Model.DeviceType == "Phone" ? "border-indigo-500 bg-indigo-50" : "border-gray-200")">
                                <i class="ph ph-device-mobile text-xl mr-3 @(Model.DeviceType == "Phone" ? "text-indigo-600" : "text-gray-400")"></i>
                                <span class="text-sm font-bold @(Model.DeviceType == "Phone" ? "text-indigo-800" : "text-gray-600")">Aplicație Nativă OS</span>
                            </div>
                        </label>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Viewport Player -->
    <div class="lg:col-span-7">
        <div class="bg-gray-900 rounded-2xl shadow-xl overflow-hidden h-full min-h-[300px] flex flex-col relative border border-gray-800">
            <!-- Player Header -->
            <div class="bg-gray-950 px-4 py-3 flex justify-between items-center border-b border-gray-800">
                <div class="flex items-center space-x-2">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                </div>
                <div class="text-xs tracking-wide text-gray-500 flex items-center">
                    <i class="ph ph-lock-key mr-1"></i> AES-256 Encrypted Stream
                </div>
            </div>
            
            <!-- Player Body -->
            <div class="flex-grow flex items-center justify-center p-8 relative">
                <!-- Abstract visual representation -->
                @if (Model.MediaType == "Video")
                {
                    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] mix-blend-overlay"></div>
                }
                else
                {
                    <div class="absolute inset-0 flex items-center justify-center opacity-10">
                        <div class="w-full h-1 bg-amber-500"></div>
                        <div class="w-full h-1 bg-amber-500 absolute rotate-45 scale-x-150"></div>
                        <div class="w-full h-1 bg-amber-500 absolute -rotate-45 scale-x-150"></div>
                    </div>
                }

                <div class="relative z-10 text-center">
                    <div class="w-24 h-24 rounded-full bg-amber-500/20 flex items-center justify-center mx-auto mb-6 shadow-[0_0_30px_rgba(245,158,11,0.3)] border border-amber-500/50 relative">
                        @if (Model.MediaType == "Video") {
                            <i class="ph ph-play-circle text-5xl text-amber-400"></i>
                        } else {
                            <i class="ph ph-waveform text-5xl text-amber-400"></i>
                            <div class="absolute -right-2 -top-2 w-6 h-6 bg-red-500 rounded-full animate-ping"></div>
                            <div class="absolute -right-2 -top-2 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center text-[10px] text-white font-bold">REC</div>
                        }
                    </div>
                    
                    <h2 class="text-2xl font-bold text-white mb-2 tracking-wide">LIVE FEED</h2>
                    
                    <!-- Text returnat de Bridge Pattern -->
                    <div class="inline-block bg-gray-800/80 backdrop-blur-sm border border-gray-700 px-6 py-3 rounded-xl mt-4 max-w-md">
                        <p class="text-amber-400 font-medium tracking-wide text-sm">@Model.Result</p>
                    </div>
                </div>
            </div>
            
            <!-- Player Footer Controls -->
            <div class="bg-gray-950/80 backdrop-blur-md px-6 py-4 border-t border-gray-800 flex items-center justify-between">
                <div class="flex items-center space-x-4 text-gray-400 text-xl">
                    <i class="ph ph-play-pause hover:text-white cursor-pointer transition-colors"></i>
                    <i class="ph ph-skip-forward hover:text-white cursor-pointer transition-colors"></i>
                    <i class="ph ph-speaker-high hover:text-white cursor-pointer transition-colors"></i>
                </div>
                <div class="flex-grow mx-6">
                    <div class="h-1.5 w-full bg-gray-800 rounded-full overflow-hidden">
                        <div class="h-full bg-amber-500 w-1/3 animate-pulse"></div>
                    </div>
                </div>
                <div class="text-xs tracking-wide text-amber-500/70">
                    <i class="ph ph-broadcast"></i> @(Model.DeviceType == "Tv" ? "HD_STREAM" : "LQ_MOBILE")
                </div>
            </div>
        </div>
    </div>
</div>
