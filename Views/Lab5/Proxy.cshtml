@model TMPP_CRM.Controllers.ProxyViewModel

@{
    ViewData["Title"] = "Proxy Pattern Demo";
}

<div class="mb-6">
    <a asp-controller="Lab5" asp-action="Index" class="text-purple-600 hover:text-purple-800 font-medium">&larr; Înapoi la Laborator 5</a>
</div>

<div class="bg-white rounded-2xl shadow-lg p-8 max-w-3xl mx-auto border border-gray-100">
    <h1 class="text-3xl font-bold text-gray-800 mb-6 flex items-center">
        <span class="text-4xl mr-3">🛡️</span> Proxy Pattern Demo (Protection)
    </h1>

    <div class="flex flex-col md:flex-row gap-8 mb-8">
        <!-- Controale -->
        <div class="md:w-1/3 bg-gray-50 p-6 rounded-xl border border-gray-200">
            <h3 class="text-lg font-semibold mb-4 text-gray-700">Simulare Login</h3>
            <form method="get" asp-action="Proxy">
                <label class="block text-sm text-gray-600 mb-2">Alege rolul utilizatorului:</label>
                <div class="space-y-3 mb-6">
                    <label class="flex items-center space-x-2">
                        <input type="radio" name="role" value="Admin" @(Model.Role == "Admin" ? "checked" : "") class="text-purple-600 focus:ring-purple-500">
                        <span class="font-medium text-red-600">Admin</span>
                    </label>
                    <label class="flex items-center space-x-2">
                        <input type="radio" name="role" value="Agent" @(Model.Role == "Agent" ? "checked" : "") class="text-purple-600 focus:ring-purple-500">
                        <span class="font-medium text-blue-600">Agent</span>
                    </label>
                    <label class="flex items-center space-x-2">
                        <input type="radio" name="role" value="Guest" @(Model.Role == "Guest" ? "checked" : "") class="text-purple-600 focus:ring-purple-500">
                        <span class="font-medium text-gray-600">Guest</span>
                    </label>
                </div>
                
                <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded-lg transition duration-200">
                    Schimbă Rolul
                </button>
            </form>
        </div>

        <!-- Rezultate -->
        <div class="md:w-2/3 space-y-4">
            <div class="p-5 rounded-xl border @(Model.ReadResult.StartsWith("Eroare") ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200")">
                <h4 class="text-sm font-bold uppercase tracking-wider mb-2 @(Model.ReadResult.StartsWith("Eroare") ? "text-red-700" : "text-green-700")">
                    Test Citire Date Client
                </h4>
                <p class="text-gray-800">@Model.ReadResult</p>
                <p class="text-xs text-gray-500 mt-2">Necesar: Admin, Manager sau Agent</p>
            </div>

            <div class="p-5 rounded-xl border @(Model.WriteResult.StartsWith("Eroare") ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200")">
                <h4 class="text-sm font-bold uppercase tracking-wider mb-2 @(Model.WriteResult.StartsWith("Eroare") ? "text-red-700" : "text-green-700")">
                    Test Scriere Date Financiare
                </h4>
                <p class="text-gray-800">@Model.WriteResult</p>
                <p class="text-xs text-gray-500 mt-2">Necesar: Admin sau Manager</p>
            </div>
        </div>
    </div>
</div>
