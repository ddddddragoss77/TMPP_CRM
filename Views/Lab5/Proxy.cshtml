@model TMPP_CRM.Controllers.ProxyInputViewModel

@{
    ViewData["Title"] = "Firewall & Control Acces";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center">
            <i class="ph ph-shield-check text-purple-600 mr-3 text-3xl"></i>
            Firewall de Protecție Internă
        </h1>
        <p class="text-gray-500 mt-1">Interceptează și validează cererile către baza de date financiară pe baza rolului (RBAC).</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controale -->
    <div class="lg:col-span-4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="font-bold text-gray-800 mb-6 flex items-center border-b border-gray-100 pb-3">
                <i class="ph ph-identification-badge mr-2 text-purple-500"></i> Simulator Identitate
            </h3>

            <form method="post" asp-action="Proxy" class="space-y-5">
                @Html.AntiForgeryToken()

                <!-- Username -->
                <div>
                    <label asp-for="Username" class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-1">Username</label>
                    <input asp-for="Username" placeholder="ex: ion.popescu"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-purple-400 outline-none transition" />
                </div>

                <!-- Rol -->
                <div>
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-3">Nivel Clearance</label>
                    <div class="space-y-2">
                        @foreach (var r in new[] {
                            ("Admin",   "Administrator",    "red",    "ph-crown",              "Acces total R/W"),
                            ("Manager", "Manager",          "orange", "ph-briefcase",          "Acces citire + scriere financiar"),
                            ("Agent",   "Agent Vânzări",    "blue",   "ph-headset",            "Acces citire date clienți"),
                            ("Guest",   "Vizitator Anonim", "gray",   "ph-user",               "Fără acces la date")
                        })
                        {
                            <label class="flex items-center p-3 border-2 rounded-xl cursor-pointer transition-all @(Model.Role == r.Item1 ? $"border-{r.Item3}-400 bg-{r.Item3}-50" : "border-gray-200 hover:border-gray-300")">
                                <input type="radio" name="Role" value="@r.Item1"
                                       @(Model.Role == r.Item1 ? "checked" : "") class="sr-only">
                                <div class="w-9 h-9 rounded-full bg-@r.Item3-100 flex items-center justify-center mr-3">
                                    <i class="ph @r.Item4 text-@r.Item3-600"></i>
                                </div>
                                <div>
                                    <span class="block font-bold text-gray-900 text-sm">@r.Item2</span>
                                    <span class="block text-xs text-gray-500">@r.Item5</span>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <!-- Parametri Cerere -->
                <div class="border-t border-gray-100 pt-4">
                    <label class="block text-xs font-bold text-gray-600 uppercase tracking-widest mb-3">Parametri Cerere</label>
                    <div class="space-y-3">
                        <div>
                            <label asp-for="CustomerId" class="block text-xs text-gray-500 mb-1">ID Client (Read)</label>
                            <input asp-for="CustomerId" type="number" min="1"
                                   class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-purple-400 outline-none" />
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label asp-for="RecordId" class="block text-xs text-gray-500 mb-1">ID Record (Write)</label>
                                <input asp-for="RecordId" type="number" min="1"
                                       class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-purple-400 outline-none" />
                            </div>
                            <div>
                                <label asp-for="Amount" class="block text-xs text-gray-500 mb-1">Sumă (lei)</label>
                                <input asp-for="Amount" type="number" step="0.01" min="0"
                                       class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-purple-400 outline-none" />
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit"
                        class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-xl shadow-md shadow-purple-600/20 transition-colors flex justify-center items-center">
                    <i class="ph ph-shield-check mr-2 text-lg"></i> Testează Accesul
                </button>
            </form>

            <div class="mt-5 bg-purple-50 p-4 rounded-xl border border-purple-100 flex items-start text-xs text-purple-800">
                <i class="ph ph-info text-lg mr-2 text-purple-600 flex-shrink-0"></i>
                <p>Fiecare cerere trece prin Proxy-ul de securitate care verifică rolul înainte de a delega la resursa reală.</p>
            </div>
        </div>
    </div>

    <!-- Output Logs -->
    <div class="lg:col-span-8 space-y-6">
        @if (Model.HasResult)
        {
            <!-- Read Test -->
            <div class="bg-white rounded-2xl shadow-sm border overflow-hidden @(Model.ReadResult.StartsWith("Eroare") ? "border-red-200" : "border-emerald-200")">
                <div class="px-6 py-4 flex justify-between items-center @(Model.ReadResult.StartsWith("Eroare") ? "bg-red-50 border-red-100" : "bg-emerald-50 border-emerald-100") border-b">
                    <h4 class="font-bold flex items-center @(Model.ReadResult.StartsWith("Eroare") ? "text-red-800" : "text-emerald-800")">
                        <i class="ph ph-eye mr-2 text-xl"></i> Test: Citire Date Client (GetCustomerData #@Model.CustomerId)
                    </h4>
                    <span class="px-3 py-1 rounded-full text-xs font-bold @(Model.ReadResult.StartsWith("Eroare") ? "bg-red-100 text-red-700" : "bg-emerald-100 text-emerald-700")">
                        @(Model.ReadResult.StartsWith("Eroare") ? "403 DENIED" : "200 OK")
                    </span>
                </div>
                <div class="p-6">
                    <div class="flex items-start">
                        <i class="ph @(Model.ReadResult.StartsWith("Eroare") ? "ph-x-octagon text-red-500" : "ph-check-circle text-emerald-500") text-4xl mr-4"></i>
                        <div class="flex-1">
                            <h5 class="font-bold mb-2 @(Model.ReadResult.StartsWith("Eroare") ? "text-red-600" : "text-emerald-600")">
                                @(Model.ReadResult.StartsWith("Eroare") ? "Acces Interzis" : "Acces Aprobat")
                            </h5>
                            <p class="text-gray-700 text-sm bg-gray-50 p-3 rounded-lg border border-gray-200 font-mono">@Model.ReadResult</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Write Test -->
            <div class="bg-white rounded-2xl shadow-sm border overflow-hidden @(Model.WriteResult.StartsWith("Eroare") ? "border-red-200" : "border-emerald-200")">
                <div class="px-6 py-4 flex justify-between items-center @(Model.WriteResult.StartsWith("Eroare") ? "bg-red-50 border-red-100" : "bg-emerald-50 border-emerald-100") border-b">
                    <h4 class="font-bold flex items-center @(Model.WriteResult.StartsWith("Eroare") ? "text-red-800" : "text-emerald-800")">
                        <i class="ph ph-pencil-simple mr-2 text-xl"></i> Test: Modificare Financiară (Record #@Model.RecordId — @Model.Amount lei)
                    </h4>
                    <span class="px-3 py-1 rounded-full text-xs font-bold @(Model.WriteResult.StartsWith("Eroare") ? "bg-red-100 text-red-700" : "bg-emerald-100 text-emerald-700")">
                        @(Model.WriteResult.StartsWith("Eroare") ? "403 DENIED" : "200 OK")
                    </span>
                </div>
                <div class="p-6">
                    <div class="flex items-start">
                        <i class="ph @(Model.WriteResult.StartsWith("Eroare") ? "ph-x-octagon text-red-500" : "ph-check-circle text-emerald-500") text-4xl mr-4"></i>
                        <div class="flex-1">
                            <h5 class="font-bold mb-2 @(Model.WriteResult.StartsWith("Eroare") ? "text-red-600" : "text-emerald-600")">
                                @(Model.WriteResult.StartsWith("Eroare") ? "Acces Interzis" : "Acces Aprobat")
                            </h5>
                            <p class="text-gray-700 text-sm bg-gray-50 p-3 rounded-lg border border-gray-200 font-mono">@Model.WriteResult</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary -->
            <div class="bg-gray-900 rounded-2xl p-6 text-sm font-mono text-gray-300">
                <p class="text-purple-400 mb-2">▶ Proxy::CheckAuthorization(user="@(string.IsNullOrWhiteSpace(Model.Username) ? "testUser" : Model.Username)", role="@Model.Role")</p>
                <p class="@(Model.ReadResult.StartsWith("Eroare") ? "text-red-400" : "text-emerald-400")">  Read → @(Model.ReadResult.StartsWith("Eroare") ? "BLOCKED" : "ALLOWED → RealResource.GetCustomerData()")</p>
                <p class="@(Model.WriteResult.StartsWith("Eroare") ? "text-red-400" : "text-emerald-400")">  Write → @(Model.WriteResult.StartsWith("Eroare") ? "BLOCKED" : "ALLOWED → RealResource.UpdateFinancialRecords()")</p>
            </div>
        }
        else
        {
            <div class="h-full min-h-[400px] flex items-center justify-center bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                <div class="text-center text-gray-400">
                    <i class="ph ph-shield-slash text-6xl mb-4 block opacity-30"></i>
                    <p class="font-medium">Selectează un rol și apasă<br><strong>„Testează Accesul"</strong> pentru a vedea rezultatele.</p>
                </div>
            </div>
        }
    </div>
</div>
